// Shared design tokens for the whole app: "Violet Night" -- the HexaTalk
// identity. Deep plum-tinted dark surfaces, a violet accent (#8B5CF6
// family), rounded corners and soft shadows. Every pre-existing token name
// is preserved -- other files reference them -- only values changed; new
// tokens are purely additive (status idle/dnd, radius scale, soft-shadow
// blur, control greys, warning washes).
export global Theme {
    // ---------- UI scale (globalny zoom jak na Discordzie) ----------
    // Mnożnik dla typografii, spacingu i promieni. Ustawiany z ustawień
    // (Settings → Appearance) i persistowany w settings.json. Wartości
    // zakodowane na sztywno (px literalami) nie skalują się — dlatego nowy
    // kod powinien używać tokenów, nie magic numbers.
    in-out property <float> ui-scale: 1.0;

    // ---------- Backgrounds ----------
    // Main chat surface.
    out property <color> bg-primary: #221d2c;
    // Channel/DM sidebar.
    out property <color> bg-secondary: #1c1726;
    // Deepest surface: server rail, text inputs.
    out property <color> bg-tertiary: #141019;
    // Raised panels one step above the surface they sit on.
    out property <color> bg-elevated: #2c2538;
    // Hover on interactive rows (channel rows, member rows).
    out property <color> bg-hover: #332b44;
    // Half-strength hover wash, for large surfaces (message rows) where the
    // full bg-hover would read as a selection.
    out property <color> bg-hover-soft: #332b4480;
    // Floating surfaces (context menus, popovers, tooltips): near-black, one
    // step below everything else, paired with a soft shadow.
    out property <color> bg-floating: #0f0c14;
    // Selected/active surface (current channel, active server, toggled row):
    // clearly lighter than bg-hover so a hover pass is still visible on top.
    out property <color> bg-active: #3d3452;

    // ---------- Accent (violet) ----------
    // Canonical violet -- focus rings, links, highlights, hover state of
    // accent-filled buttons.
    out property <color> accent: #8b5cf6;
    // Rest state of accent-filled buttons (one step dimmer than the hover).
    out property <color> accent-dim: #7c4de8;
    // Pressed state for accent-filled buttons (one step below accent-dim).
    out property <color> accent-pressed: #6939d1;
    // Hover highlight one step above accent -- thin strokes/borders that
    // need to brighten without a full fill change.
    out property <color> accent-hover: #a78bfa;
    out property <color> accent-soft: #8b5cf62e;
    out property <color> accent-soft-strong: #8b5cf63d;

    // ---------- Text ----------
    out property <color> text-primary: #e3deee;
    out property <color> text-muted: #9c94ad;
    // Text on violet fills: white.
    out property <color> text-on-accent: #ffffff;
    // Text on amber/warning fills (OWNER badge and friends): near-black.
    out property <color> text-on-warning: #241a04;
    // Headlines / important bright text.
    out property <color> text-bright: #ffffff;
    // Inline links: light violet, readable on the dark plum surfaces.
    out property <color> text-link: #c4b5fd;
    // Mention highlight (@user): light violet text over a soft accent wash.
    out property <color> mention-text: #d9cefc;
    out property <color> mention-bg: #8b5cf64d;

    // ---------- Borders ----------
    // Neutral, low-contrast borders -- the design relies on surface contrast
    // more than strokes, so these stay quiet.
    out property <color> border: #383045;
    out property <color> border-strong: #4a4258;
    out property <color> border-hairline: #ffffff12;

    // ---------- Secondary controls (grey buttons) ----------
    out property <color> bg-control: #453d54;
    out property <color> bg-control-hover: #584e6b;
    out property <color> bg-control-pressed: #383045;

    // ---------- Status ----------
    out property <color> online: #23a55a;
    out property <color> idle: #f0b232;
    out property <color> dnd: #f23f43;
    out property <color> offline: #80848e;
    out property <color> danger: #da373c;
    out property <color> danger-soft: #da373c24;
    // Danger outline at rest (one notch quieter than full danger).
    out property <color> danger-dim: #da373c99;
    // Pressed fill for danger buttons (solid, one step below danger).
    out property <color> danger-pressed: #a12828;
    out property <color> warning: #f0b232;
    out property <color> success: #23a55a;

    // ---------- PLUS subscription badge (gold) ----------
    // Gold fill for the PLUS chip; pair with `plus-foreground` for its text.
    out property <color> plus: #c9a227;
    out property <color> plus-foreground: #1a1400;

    // ---------- Warning washes (pinned rows, ringing calls, announcement
    // channels, warning boxes) -- alpha-stepped variants of `warning`, so
    // call sites never hand-tune magic hex. ----------
    out property <color> warning-softest: #f0b2320a;
    out property <color> warning-softer: #f0b23214;
    out property <color> warning-soft: #f0b2321a;
    out property <color> warning-glow: #f0b2322e;
    out property <color> warning-border: #f0b23259;
    out property <color> warning-dim: #f0b232cc;

    // ---------- Shape ----------
    // Rounded, friendly geometry: small controls ~4-6px, cards/popovers
    // ~12px. `radius` is the historical single token -- now the default
    // control radius; prefer the scale below for new code. All scaled by
    // ui-scale.
    out property <length> radius: 6px * root.ui-scale;
    out property <length> radius-sm: 4px * root.ui-scale;
    out property <length> radius-md: 8px * root.ui-scale;
    out property <length> radius-lg: 12px * root.ui-scale;

    // ---------- Spacing scale ----------
    out property <length> space-1: 4px * root.ui-scale;
    out property <length> space-2: 8px * root.ui-scale;
    out property <length> space-3: 12px * root.ui-scale;
    out property <length> space-4: 16px * root.ui-scale;
    out property <length> space-5: 24px * root.ui-scale;
    out property <length> space-6: 32px * root.ui-scale;

    // ---------- Typography ----------
    out property <string> font-body: "Roboto";
    out property <string> font-medium: "Roboto Medium";
    out property <length> text-xs: 10px * root.ui-scale;
    out property <length> text-sm: 12px * root.ui-scale;
    out property <length> text-md: 14px * root.ui-scale;
    out property <length> text-lg: 18px * root.ui-scale;
    out property <length> text-xl: 24px * root.ui-scale;

    // ---------- Shadows (soft: low offset + blur) ----------
    out property <brush> shadow-color: #00000059;
    out property <length> shadow-offset: 2px;
    out property <length> shadow-offset-light: 1px;
    // Blur radii for the soft look -- pair with drop-shadow-blur-radius.
    out property <length> shadow-blur: 8px;
    out property <length> shadow-blur-lg: 16px;
}
