// Middle panel: tab header, the 5 tab bodies (Chats/Friends/Requests/
// Servers/Admin), and the account footer. Port of the `channel_list`
// section of src/view/chat.rs.
import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Avatar, PrimaryButton, DangerButton, TextInputField, ResizeHandle, StatsChip } from "widgets.slint";
import { MentionBadge } from "rail.slint";
import {
    ConversationRow, FriendRow, IncomingRequestRow, OutgoingRequestRow,
    PeopleHitRow, SuggestionRow, BlockedRow, ServerRow, ChannelRow, AdminUserRow,
    GroupCandidateRow, ReportRow,
} from "chat_types.slint";

export enum SidebarTab { Chats, Friends, Requests, Servers, Admin }

export component SmallButton inherits Rectangle {
    in property <string> text;
    in property <color> fg: Theme.text-primary;
    in property <color> bg: Theme.bg-secondary;
    in property <color> border_c: Theme.border;
    in property <bool> enabled: true;
    callback clicked;
    height: 26px;
    width: label.preferred-width + 16px;
    opacity: root.enabled ? 1.0 : 0.5;
    background: root.bg;
    border-width: 1px;
    border-radius: Theme.radius-sm;
    border-color: touch.has-hover ? Theme.border-strong : root.border_c;
    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
    label := Text { text: root.text; font-size: 11px; color: root.fg; horizontal-alignment: center; vertical-alignment: center; }
    // Tint overlay: works over any configured `bg` (accent, danger,
    // success) without losing the base color on hover. Rounded to match.
    Rectangle {
        border-radius: Theme.radius-sm;
        background: touch.pressed ? #0000002e : (touch.has-hover ? #ffffff0d : transparent);
        animate background { duration: 120ms; }
    }
}

component PersonCard inherits Rectangle {
    background: Theme.bg-secondary;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: Theme.radius-md;
    VerticalLayout { padding: 10px; spacing: 8px; @children }
}

// Centered, muted placeholder for empty lists -- deliberately sized and
// spaced so it reads as a designed state, not a stray label.
component EmptyState inherits Rectangle {
    in property <string> text;
    in property <length> box-height: 120px;
    height: root.box-height;
    Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.text;
        font-size: Theme.text-md;
        color: Theme.text-muted;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// ---- Discord-style channel list pieces ----

// Collapsible category header ("TEXT CHANNELS" etc.) with a chevron that
// flips between down (open) and right (collapsed), brightening on hover
// like Discord. State lives in the bound `collapsed` property.
component CategoryHeader inherits Rectangle {
    in property <string> label;
    in-out property <bool> collapsed: false;
    height: 26px;

    cat-touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.collapsed = !root.collapsed; }
    }
    Path {
        x: 2px;
        y: (parent.height - self.height) / 2;
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        stroke: cat-touch.has-hover ? Theme.text-primary : Theme.text-muted;
        stroke-width: 1.5px;
        commands: root.collapsed ? "M 3 1 L 7 5 L 3 9" : "M 1 3 L 5 7 L 9 3";
    }
    Text {
        x: 14px;
        text: root.label;
        font-size: Theme.text-xs;
        font-family: Theme.font-medium;
        letter-spacing: 1px;
        color: cat-touch.has-hover ? Theme.text-primary : Theme.text-muted;
        vertical-alignment: center;
        animate color { duration: 120ms; }
    }
}

// Speaker glyph for voice channels, drawn from primitives (Roboto ships no
// speaker glyph and there is no icon asset for it).
component SpeakerGlyph inherits Rectangle {
    in property <color> fg: Theme.text-muted;
    width: 15px;
    height: 14px;
    Rectangle { x: 0px; y: 4px; width: 3.5px; height: 6px; background: root.fg; }
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 15;
        viewbox-height: 14;
        fill: root.fg;
        commands: "M 3.5 4 L 8 1 L 8 13 L 3.5 10 Z";
    }
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 15;
        viewbox-height: 14;
        stroke: root.fg;
        stroke-width: 1.3px;
        commands: "M 10 4.5 A 3 3 0 0 1 10 9.5 M 10.5 2 A 5.4 5.4 0 0 1 10.5 12";
    }
}

// One channel row: Discord-style "#" / speaker glyph, bold + bright label
// when unread, rounded red mention badge on the right, full-row
// hover/active fill (active uses the clearly-lighter bg-active token).
// NOTE: ChannelRow has no unread/mention fields yet, so `unread`/`mentions`
// stay bound to their defaults at the call sites -- the visuals are ready;
// the integrator only needs to extend the data model (see report).
component ChannelItem inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <bool> muted: false;
    in property <bool> is-announcement: false;
    in property <bool> is-voice: false;
    in property <bool> unread: false;
    in property <int> mentions: 0;
    callback clicked;

    height: 34px;
    // Muted channels dim like Discord; the active one always stays full
    // strength.
    opacity: root.muted && !root.active ? 0.55 : 1.0;
    background: root.active ? Theme.bg-active
        : (root.is-announcement ? Theme.warning-softer
        : (row-touch.has-hover ? Theme.bg-hover : transparent));
    animate background { duration: 120ms; }
    animate opacity { duration: 120ms; }

    row-touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }

    if !root.is-voice: Text {
        x: 10px;
        text: "#";
        font-size: 16px;
        font-family: Theme.font-medium;
        color: root.active || root.unread || row-touch.has-hover ? Theme.text-primary : Theme.text-muted;
        vertical-alignment: center;
        animate color { duration: 120ms; }
    }
    if root.is-voice: SpeakerGlyph {
        x: 10px;
        y: (parent.height - self.height) / 2;
        fg: root.active || root.unread || row-touch.has-hover ? Theme.text-primary : Theme.text-muted;
    }
    Text {
        x: 32px;
        width: parent.width - 40px - (root.mentions > 0 ? 30px : 0px);
        text: root.label;
        font-size: 13px;
        font-family: root.active || root.unread ? Theme.font-medium : Theme.font-body;
        // Announcements stay visually pinned/highlightable for everyone.
        color: root.is-announcement
            ? (root.active ? Theme.warning : Theme.warning-dim)
            : (root.active || root.unread || row-touch.has-hover ? Theme.text-primary : Theme.text-muted);
        vertical-alignment: center;
        overflow: elide;
        animate color { duration: 120ms; }
    }
    if root.mentions > 0: MentionBadge {
        ring-color: root.active ? Theme.bg-active : Theme.bg-secondary;
        text: root.mentions > 9 ? "9+" : root.mentions;
        x: parent.width - self.width - 6px;
        y: (parent.height - self.height) / 2;
    }
}

// ---- Discord-style user panel pieces ----

// Mic glyph (16x16, drawn from primitives).
component MicGlyph inherits Rectangle {
    in property <color> fg: Theme.text-muted;
    width: 16px;
    height: 16px;
    Rectangle { x: 5.5px; y: 1px; width: 5px; height: 8.5px; border-radius: 2.5px; background: root.fg; }
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: root.fg;
        stroke-width: 1.4px;
        commands: "M 3 7.5 A 5 5.5 0 0 0 13 7.5";
    }
    Rectangle { x: 7.3px; y: 12.6px; width: 1.4px; height: 2px; background: root.fg; }
    Rectangle { x: 4.6px; y: 14.6px; width: 6.8px; height: 1.3px; background: root.fg; }
}

// Headphones (deafen) glyph (16x16, drawn from primitives).
component HeadphonesGlyph inherits Rectangle {
    in property <color> fg: Theme.text-muted;
    width: 16px;
    height: 16px;
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 16;
        viewbox-height: 16;
        stroke: root.fg;
        stroke-width: 1.6px;
        commands: "M 2.5 11 A 5.5 5.5 0 0 1 13.5 11";
    }
    Rectangle { x: 1px; y: 9px; width: 3.5px; height: 6.5px; border-radius: 1.5px; background: root.fg; }
    Rectangle { x: 11.5px; y: 9px; width: 3.5px; height: 6.5px; border-radius: 1.5px; background: root.fg; }
}

// Settings gear glyph (16x16): a ring plus eight teeth. Teeth are plain
// squares -- Slint elements can't rotate, and at this size square diagonal
// teeth still read as a cog.
component GearGlyph inherits Rectangle {
    in property <color> fg: Theme.text-muted;
    width: 16px;
    height: 16px;
    Rectangle { x: 4px; y: 4px; width: 8px; height: 8px; border-radius: 4px; border-width: 2px; border-color: root.fg; background: transparent; }
    Rectangle { x: 7px; y: 0.4px; width: 2px; height: 2.6px; background: root.fg; }
    Rectangle { x: 7px; y: 13px; width: 2px; height: 2.6px; background: root.fg; }
    Rectangle { x: 0.4px; y: 7px; width: 2.6px; height: 2px; background: root.fg; }
    Rectangle { x: 13px; y: 7px; width: 2.6px; height: 2px; background: root.fg; }
    Rectangle { x: 3.2px; y: 3.2px; width: 2.2px; height: 2.2px; background: root.fg; }
    Rectangle { x: 10.6px; y: 3.2px; width: 2.2px; height: 2.2px; background: root.fg; }
    Rectangle { x: 3.2px; y: 10.6px; width: 2.2px; height: 2.2px; background: root.fg; }
    Rectangle { x: 10.6px; y: 10.6px; width: 2.2px; height: 2.2px; background: root.fg; }
}

// Square 32px icon button for the user panel (mute/deafen/settings), like
// Discord's icon-only controls: quiet muted glyph, brightens on hover, and
// a danger slash + tint when toggled. Glyph children bind `parent.fg`.
component PanelButton inherits Rectangle {
    in property <bool> toggled: false;
    out property <color> fg: root.toggled ? Theme.danger
        : (panel-touch.has-hover ? Theme.text-primary : Theme.text-muted);
    callback clicked;

    width: 32px;
    height: 32px;
    background: panel-touch.has-hover ? Theme.bg-hover : transparent;
    animate background { duration: 120ms; }

    panel-touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }

    @children

    if root.toggled: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 32;
        viewbox-height: 32;
        stroke: Theme.danger;
        stroke-width: 2px;
        commands: "M 5 27 L 27 5";
    }
}

export component Sidebar inherits Rectangle {
    in property <SidebarTab> tab: SidebarTab.Chats;
    in property <string> tab_title: "Direct";
    in property <bool> selected_server: false;

    in property <length> panel_width: 320px;

    // Server status line, shared between the (now window-level popup)
    // add-server flow and the in-panel new-channel flow below.
    in property <string> server_status;

    // Chats tab
    in property <bool> new_group_open: false;
    in-out property <string> new_group_name;
    in property <[GroupCandidateRow]> group_candidates: [];
    in property <string> group_create_status;
    in property <[ConversationRow]> conversations: [];

    // Friends tab
    in property <string> friends_summary;
    in-out property <string> add_friend_input;
    in-out property <string> add_friend_note;
    in property <string> add_friend_status;
    in property <int> friends_filter: 0; // 0=All 1=Online 2=Favorites
    in property <[PeopleHitRow]> people_hits: [];
    in property <[SuggestionRow]> suggestions: [];
    in-out property <string> friends_filter_input;
    in property <[FriendRow]> friends: [];
    in property <[BlockedRow]> blocked: [];
    in property <string> confirm_block_user_id;
    in property <bool> friend_request_busy: false;

    // Requests tab
    in property <[IncomingRequestRow]> incoming_requests: [];
    in property <[OutgoingRequestRow]> outgoing_requests: [];

    // Servers tab
    in property <string> server_name;
    in property <string> server_meta;
    in property <bool> can_manage_server: false;
    in property <string> invite_code;
    in property <bool> can_manage_channels: false;
    in property <[ChannelRow]> text_channels: [];
    in property <[ChannelRow]> voice_channels: [];

    // Admin tab
    in-out property <string> admin_search;
    in property <string> admin_status;
    in property <[AdminUserRow]> admin_users: [];

    in property <bool> is_admin: false;

    in property <int> admin_total_users: 0;
    in property <int> admin_online: 0;
    in property <int> admin_banned: 0;
    in property <int> admin_staff: 0;
    in property <int> admin_bots: 0;
    in property <int> admin_servers: 0;
    in property <[ReportRow]> admin_reports: [];
    in property <string> admin_reports_status;
    callback admin_resolve_report(string, string);
    // Account footer
    in property <string> my_display_name;
    in property <string> my_initial;
    in property <color> my_avatar_color: Theme.accent;
    in property <image> my_photo;
    in property <string> my_badge_text;
    in property <color> my_badge_bg;
    in property <color> my_badge_fg;
    // Own presence for the account footer: raw status ("online" / "idle" /
    // "dnd" / "invisible") drives the dot color, the label is the display
    // string (Rust's presence_label).
    in property <string> my_presence_status: "online";
    in property <string> my_presence_label: "Online";
    // User panel voice state (Discord-style mic/deafen). Driven from Rust
    // (the real capture/playback mute flags shared with the audio
    // pipelines); the buttons only fire the toggle callbacks, the next UI
    // sync repaints the glyphs.
    in property <bool> mic_muted: false;
    in property <bool> deafened: false;
    // Collapse state for the two channel category headers. UI-local with
    // defaults, so neither main.slint nor Rust has to bind them.
    in-out property <bool> text_channels_collapsed: false;
    in-out property <bool> voice_channels_collapsed: false;
    callback toggle_mute;
    callback toggle_deafen;

    callback toggle_group_panel;
    callback group_name_changed(string);
    callback toggle_group_member(string);
    callback create_group;
    callback open_conversation(string);

    callback add_friend_input_changed(string);
    callback add_friend_note_changed(string);
    callback send_friend_request;
    callback set_friends_filter(int);
    callback friends_filter_input_changed(string);
    callback open_profile(string);
    callback send_friend_request_to(string);
    callback message_friend(string);
    callback toggle_favorite(string);
    callback remove_friend(string);
    callback confirm_block(string);
    callback cancel_block;
    callback block_user(string);
    callback unblock_user(string);
    callback respond_request(string, string, bool);
    callback accept_all;
    callback decline_all;
    callback cancel_outgoing(string);

    callback select_server;
    callback toggle_server_settings;
    callback copy_invite_link(string);
    callback toggle_new_channel;
    callback open_channel(string);

    callback admin_search_changed(string);
    callback admin_set_role(string, string);
    callback admin_set_banned(string, bool);

    callback open_settings;

    callback resize_started;
    callback resize_moved(length);
    callback resize_ended;

    width: root.panel_width + 4px;
    background: transparent;

    HorizontalLayout {
        Rectangle {
            width: root.panel_width;
            background: Theme.bg-secondary;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                // ---- Header ----
                Rectangle {
                    height: 56px;
                    border-width: 0px;

                    // Discord-style server header (Servers tab with a server
                    // selected): server name + chevron, full-row hover fill,
                    // click opens server settings (requires manage perms).
                    if root.tab == SidebarTab.Servers && root.selected_server: Rectangle {
                        background: server-head-touch.has-hover ? Theme.bg-hover : transparent;
                        animate background { duration: 120ms; }
                        server-head-touch := TouchArea {
                            mouse-cursor: root.can_manage_server ? MouseCursor.pointer : MouseCursor.default;
                            clicked => {
                                if (root.can_manage_server) {
                                    root.toggle_server_settings();
                                }
                            }
                        }
                        Text {
                            x: 16px;
                            width: parent.width - 48px;
                            text: root.server_name;
                            font-size: 15px;
                            font-family: Theme.font-medium;
                            color: Theme.text-primary;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        Path {
                            x: parent.width - 26px;
                            y: (parent.height - self.height) / 2;
                            width: 12px;
                            height: 12px;
                            viewbox-width: 12;
                            viewbox-height: 12;
                            stroke: server-head-touch.has-hover ? Theme.text-primary : Theme.text-muted;
                            stroke-width: 1.6px;
                            commands: "M 2 4 L 6 8 L 10 4";
                        }
                    }

                    // Generic tab header for the other tabs (unchanged).
                    if !(root.tab == SidebarTab.Servers && root.selected_server): VerticalLayout {
                        padding: 16px;
                        spacing: 2px;
                        alignment: center;
                        Text { text: root.tab_title.to-uppercase(); font-size: Theme.text-xs; font-family: Theme.font-medium; letter-spacing: 1px; color: Theme.text-muted; }
                        Text { text: root.tab_title; font-size: 16px; font-family: Theme.font-medium; color: Theme.text-primary; }
                    }
                    Rectangle { x: 0; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.border-hairline; }
                }

                // ---- Tab body ----
                Rectangle {
                    vertical-stretch: 1;

                    if root.tab == SidebarTab.Chats: VerticalLayout {
        opacity: 0;
        init => { self.opacity = 1; }
        animate opacity { duration: 140ms; }
                        padding: 12px;
                        spacing: 8px;
                        SmallButton { text: root.new_group_open ? "Cancel" : "+ New group"; clicked => { root.toggle_group_panel(); } }
                        if root.new_group_open: PersonCard {
                            TextInputField { placeholder: "Group name"; value <=> root.new_group_name; edited(t) => { root.group_name_changed(t); } }
                            for f in root.group_candidates: HorizontalLayout {
                                spacing: 6px;
                                Rectangle {
                                    width: 16px; height: 16px;
                                    background: f.selected ? Theme.accent : transparent;
                                    border-width: 1px;
                                    border-radius: Theme.radius-sm;
                                    border-color: check-touch.has-hover ? Theme.accent : Theme.border-strong;
                                    check-touch := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.toggle_group_member(f.user_id); }
                                    }
                                }
                                Text { text: f.label; font-size: Theme.text-sm; color: Theme.text-primary; vertical-alignment: center; }
                            }
                            PrimaryButton { text: "Create group"; clicked => { root.create_group(); } }
                            if root.group_create_status != "": Text { text: root.group_create_status; font-size: 11px; color: Theme.text-muted; }
                        }
                        if root.conversations.length == 0: EmptyState { text: "No chats yet. Message a friend to start."; }
                        if root.conversations.length > 0: Text { text: "DIRECT MESSAGES"; font-size: Theme.text-xs; font-family: Theme.font-medium; letter-spacing: 1px; color: Theme.text-muted; }
                        list_convos := ListView {
                            for c in root.conversations: Rectangle {
                                height: 40px;
                                // Same active style as ChannelItem: bg-active
                                // fill, no border.
                                background: c.active ? Theme.bg-active : (ct.has-hover ? Theme.bg-hover : transparent);
                                animate background { duration: 120ms; }
                                ct := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.open_conversation(c.id); }
                                }
                                // Active conversation spine (square).
                                if c.active: Rectangle {
                                    x: 0;
                                    y: 0;
                                    width: 3px;
                                    height: parent.height;
                                    background: Theme.accent;
                                }
                                // Unread pill: short accent stub on the left edge,
                                // vertically centered -- mutually exclusive with the
                                // full-height active spine above, so they never
                                // overlap. Fixed title padding below keeps the title
                                // from shifting when a chat is read.
                                if c.unread && !c.active: Rectangle {
                                    x: 0;
                                    y: (parent.height - self.height) / 2;
                                    width: 3px;
                                    height: 16px;
                                    background: Theme.accent;
                                }
                                HorizontalLayout {
                                    padding-left: 14px;
                                    alignment: start;
                                    Text {
                                        text: c.title;
                                        font-size: Theme.text-md;
                                        font-family: c.unread && !c.active ? Theme.font-medium : Theme.font-body;
                                        color: c.active || c.unread || ct.has-hover ? Theme.text-primary : Theme.text-muted;
                                        vertical-alignment: center;
                                        animate color { duration: 120ms; }
                                    }
                                }
                            }
                        }
                    }

                    if root.tab == SidebarTab.Friends: Flickable {
        opacity: 0;
        init => { self.opacity = 1; }
        animate opacity { duration: 140ms; }
                        viewport-height: friends_col.preferred-height;
                        friends_col := VerticalLayout {
                            width: parent.width;
                            padding: 12px;
                            spacing: 10px;
                            // Friends banner -- framed by the column padding,
                            // rounded to match the rest of the UI.
                            Rectangle {
                                height: 96px;
                                border-width: 1px;
                                border-color: Theme.border-strong;
                                border-radius: Theme.radius-md;
                                clip: true;
                                Image {
                                    source: @image-url("../assets/textures/friendsbaner.png");
                                    width: parent.width;
                                    height: parent.height;
                                    image-fit: ImageFit.cover;
                                }
                            }
                            Text { text: root.friends_summary; font-size: Theme.text-xs; font-family: Theme.font-medium; color: Theme.text-muted; }
                            HorizontalLayout {
                                spacing: 8px;
                                TextInputField { placeholder: "Search people or @username"; value <=> root.add_friend_input; edited(t) => { root.add_friend_input_changed(t); } submitted => { root.send_friend_request(); } }
                                PrimaryButton { text: "Add"; width: 70px; clicked => { root.send_friend_request(); } }
                            }
                            TextInputField { placeholder: "Optional note (max 200)"; value <=> root.add_friend_note; edited(t) => { root.add_friend_note_changed(t); } submitted => { root.send_friend_request(); } }
                            HorizontalLayout {
                                spacing: 6px;
                                SmallButton { text: "All"; bg: root.friends_filter == 0 ? Theme.accent-soft : Theme.bg-secondary; clicked => { root.set_friends_filter(0); } }
                                SmallButton { text: "Online"; bg: root.friends_filter == 1 ? Theme.accent-soft : Theme.bg-secondary; clicked => { root.set_friends_filter(1); } }
                                SmallButton { text: "★ Fav"; bg: root.friends_filter == 2 ? Theme.accent-soft : Theme.bg-secondary; clicked => { root.set_friends_filter(2); } }
                            }
                            // Name filter for the friends list below (Rust
                            // filters `friends` by this substring).
                            TextInputField { placeholder: "Filter friends"; value <=> root.friends_filter_input; edited(t) => { root.friends_filter_input_changed(t); } }
                            if root.add_friend_status != "": Text { text: root.add_friend_status; font-size: Theme.text-sm; color: Theme.text-muted; }

                            if root.people_hits.length > 0: Text { text: "Search results"; font-size: Theme.text-xs; font-family: Theme.font-medium; color: Theme.text-muted; }
                            for hit in root.people_hits: PersonCard {
                                HorizontalLayout {
                                    spacing: 10px;
                                    Avatar { initial: hit.initial; avatar-color: hit.avatar_color; photo-source: hit.photo; show-presence: true; online: hit.online; }
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: hit.display_name; font-size: Theme.text-md; color: Theme.text-primary; }
                                        Text { text: hit.meta; font-size: 11px; color: Theme.text-muted; }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    if hit.relation == "friends": PrimaryButton { text: "Message"; width: 80px; clicked => { root.message_friend(hit.user_id); } }
                                    if hit.relation == "incoming": SmallButton { text: "Accept"; bg: Theme.success; fg: Theme.text-on-accent; clicked => { root.respond_request(hit.incoming_request_id, hit.user_id, true); } }
                                    if hit.relation == "outgoing": Text { text: "Pending…"; font-size: 11px; color: Theme.text-muted; vertical-alignment: center; }
                                    if hit.relation != "friends" && hit.relation != "incoming" && hit.relation != "outgoing": SmallButton {
                                        text: root.friend_request_busy ? "Sending…" : "Add";
                                        enabled: !root.friend_request_busy;
                                        clicked => { root.send_friend_request_to(hit.username); }
                                    }
                                    SmallButton { text: "Profile"; clicked => { root.open_profile(hit.user_id); } }
                                    if root.confirm_block_user_id == hit.user_id: SmallButton { text: "Yes"; bg: Theme.danger; fg: Theme.text-on-accent; clicked => { root.block_user(hit.user_id); } }
                                    if root.confirm_block_user_id == hit.user_id: SmallButton { text: "Cancel"; clicked => { root.cancel_block(); } }
                                    if root.confirm_block_user_id != hit.user_id: SmallButton { text: "Block"; bg: Theme.danger-soft; fg: Theme.danger; clicked => { root.confirm_block(hit.user_id); } }
                                }
                            }

                            if root.people_hits.length == 0 && root.suggestions.length > 0: Text { text: "Suggested from servers"; font-size: Theme.text-xs; font-family: Theme.font-medium; color: Theme.text-muted; }
                            for s in root.suggestions: PersonCard {
                                HorizontalLayout {
                                    spacing: 10px;
                                    Avatar { initial: s.initial; avatar-color: s.avatar_color; photo-source: s.photo; show-presence: true; online: s.online; }
                                    VerticalLayout {
                                        spacing: 2px;
                                        horizontal-stretch: 1;
                                        Text { text: s.display_name; font-size: 13px; color: Theme.text-primary; }
                                        Text { text: s.meta; font-size: 11px; color: Theme.text-muted; }
                                    }
                                    SmallButton { text: "Add"; clicked => { root.add_friend_input_changed(s.username); } }
                                    SmallButton { text: "Profile"; clicked => { root.open_profile(s.user_id); } }
                                }
                            }

                            if root.friends.length == 0: EmptyState { text: "No friends yet. Search above or accept invites."; box-height: 100px; }
                            for friend in root.friends: PersonCard {
                                HorizontalLayout {
                                    spacing: 10px;
                                    Avatar { initial: friend.initial; avatar-color: friend.avatar_color; photo-source: friend.photo; show-presence: true; online: friend.online; }
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: friend.label; font-size: Theme.text-md; color: Theme.text-primary; }
                                        Text { text: friend.subtitle; font-size: 11px; color: Theme.text-muted; }
                                        Text { text: friend.meta; font-size: Theme.text-xs; color: Theme.text-muted; }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    SmallButton { text: friend.favorite ? "★" : "☆"; clicked => { root.toggle_favorite(friend.user_id); } }
                                    SmallButton { text: "Message"; bg: Theme.accent-dim; fg: Theme.text-on-accent; clicked => { root.message_friend(friend.user_id); } }
                                    SmallButton { text: "Profile"; clicked => { root.open_profile(friend.user_id); } }
                                    SmallButton { text: "Remove"; clicked => { root.remove_friend(friend.user_id); } }
                                    if root.confirm_block_user_id == friend.user_id: SmallButton { text: "Yes"; bg: Theme.danger; fg: Theme.text-on-accent; clicked => { root.block_user(friend.user_id); } }
                                    if root.confirm_block_user_id == friend.user_id: SmallButton { text: "Cancel"; clicked => { root.cancel_block(); } }
                                    if root.confirm_block_user_id != friend.user_id: SmallButton { text: "Block"; bg: Theme.danger-soft; fg: Theme.danger; clicked => { root.confirm_block(friend.user_id); } }
                                }
                            }

                            if root.blocked.length > 0: Text { text: "Blocked"; font-size: Theme.text-xs; font-family: Theme.font-medium; color: Theme.text-muted; }
                            for b in root.blocked: PersonCard {
                                HorizontalLayout {
                                    Text { text: b.display_name; font-size: 13px; color: Theme.text-primary; vertical-alignment: center; horizontal-stretch: 1; }
                                    SmallButton { text: "Unblock"; clicked => { root.unblock_user(b.user_id); } }
                                }
                            }
                        }
                    }

                    if root.tab == SidebarTab.Requests: Flickable {
        opacity: 0;
        init => { self.opacity = 1; }
        animate opacity { duration: 140ms; }
                        viewport-height: requests_col.preferred-height;
                        requests_col := VerticalLayout {
                            width: parent.width;
                            padding: 10px;
                            spacing: 10px;
                            HorizontalLayout {
                                Text { text: "Incoming"; font-size: Theme.text-xs; font-family: Theme.font-medium; color: Theme.text-muted; vertical-alignment: center; horizontal-stretch: 1; }
                                if root.incoming_requests.length > 0: SmallButton { text: "Accept all"; bg: Theme.success; fg: Theme.text-on-accent; clicked => { root.accept_all(); } }
                                if root.incoming_requests.length > 0: SmallButton { text: "Decline all"; clicked => { root.decline_all(); } }
                            }
                            if root.incoming_requests.length == 0: EmptyState { text: "No pending invites."; box-height: 56px; }
                            for req in root.incoming_requests: PersonCard {
                                HorizontalLayout {
                                    spacing: 10px;
                                    Avatar { initial: req.initial; avatar-color: req.avatar_color; photo-source: req.photo; show-presence: true; online: req.online; }
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: req.from_display_name; font-size: Theme.text-md; color: Theme.text-primary; }
                                        Text { text: req.sub; font-size: 11px; color: Theme.text-muted; }
                                    }
                                }
                                if req.note != "": Rectangle {
                                    background: Theme.bg-tertiary;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    Text { x: 10px; y: 8px; text: req.note; font-size: Theme.text-sm; color: Theme.text-primary; wrap: word-wrap; }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    SmallButton { text: "Accept"; bg: Theme.success; fg: Theme.text-on-accent; clicked => { root.respond_request(req.request_id, req.from_user_id, true); } }
                                    SmallButton { text: "Decline"; clicked => { root.respond_request(req.request_id, req.from_user_id, false); } }
                                    SmallButton { text: "Profile"; clicked => { root.open_profile(req.from_user_id); } }
                                    if root.confirm_block_user_id == req.from_user_id: SmallButton { text: "Yes"; bg: Theme.danger; fg: Theme.text-on-accent; clicked => { root.block_user(req.from_user_id); } }
                                    if root.confirm_block_user_id == req.from_user_id: SmallButton { text: "Cancel"; clicked => { root.cancel_block(); } }
                                    if root.confirm_block_user_id != req.from_user_id: SmallButton { text: "Block"; bg: Theme.danger-soft; fg: Theme.danger; clicked => { root.confirm_block(req.from_user_id); } }
                                }
                            }

                            Text { text: "Outgoing"; font-size: Theme.text-xs; font-family: Theme.font-medium; color: Theme.text-muted; }
                            if root.outgoing_requests.length == 0: EmptyState { text: "No outgoing requests."; box-height: 56px; }
                            for req in root.outgoing_requests: PersonCard {
                                HorizontalLayout {
                                    spacing: 10px;
                                    Avatar { initial: req.initial; avatar-color: req.avatar_color; photo-source: req.photo; }
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: req.to_display_name; font-size: Theme.text-md; color: Theme.text-primary; }
                                        Text { text: "@" + req.to_username; font-size: 11px; color: Theme.text-muted; }
                                        Text { text: req.sent_label; font-size: 11px; color: Theme.text-muted; }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    SmallButton { text: "Cancel"; bg: Theme.danger-soft; fg: Theme.danger; clicked => { root.cancel_outgoing(req.request_id); } }
                                    SmallButton { text: "Profile"; clicked => { root.open_profile(req.to_user_id); } }
                                }
                            }
                        }
                    }

                    if root.tab == SidebarTab.Servers && root.selected_server: VerticalLayout {
        opacity: 0;
        init => { self.opacity = 1; }
        animate opacity { duration: 140ms; }
                        padding: 12px;
                        spacing: 6px;
                        Text { text: root.server_name; font-size: 16px; font-family: Theme.font-medium; color: Theme.text-primary; }
                        Text { text: root.server_meta; font-size: 11px; color: Theme.text-muted; }
                        HorizontalLayout {
                            spacing: 6px;
                            if root.can_manage_server: SmallButton { text: "Settings"; clicked => { root.toggle_server_settings(); } }
                            if root.invite_code != "": SmallButton { text: "Copy invite link"; clicked => { root.copy_invite_link(root.invite_code); } }
                        }
                        // Opens the window-level create-channel modal (see
                        // main.slint); no inline form here anymore.
                        if root.can_manage_channels: SmallButton { text: "+ New channel"; clicked => { root.toggle_new_channel(); } }
                        if root.server_status != "": Text { text: root.server_status; font-size: 11px; color: Theme.text-muted; }
                        list_channels := Flickable {
                            vertical-stretch: 1;
                            viewport-height: channels_col.preferred-height;
                            channels_col := VerticalLayout {
                            width: parent.width;
                            // Discord-style inset rows: 8px side margins, rows
                            // highlight as a block (no accent spine).
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            spacing: 1px;
                            if root.text_channels.length > 0: CategoryHeader {
                                label: "TEXT CHANNELS";
                                collapsed <=> root.text_channels_collapsed;
                            }
                            if root.text_channels.length > 0 && !root.text_channels_collapsed: VerticalLayout {
                                spacing: 1px;
                                for ch in root.text_channels: ChannelItem {
                                    label: ch.label;
                                    active: ch.active;
                                    muted: ch.muted;
                                    is-announcement: ch.is_announcement;
                                    // unread/mentions: no data in ChannelRow
                                    // yet (see ChannelItem note).
                                    clicked => { root.open_channel(ch.conversation_id); }
                                }
                            }
                            if root.voice_channels.length > 0: Rectangle { height: 6px; }
                            if root.voice_channels.length > 0: CategoryHeader {
                                label: "VOICE CHANNELS";
                                collapsed <=> root.voice_channels_collapsed;
                            }
                            if root.voice_channels.length > 0 && !root.voice_channels_collapsed: VerticalLayout {
                                spacing: 1px;
                                for ch in root.voice_channels: ChannelItem {
                                    label: ch.label;
                                    active: ch.active;
                                    muted: ch.muted;
                                    is-voice: true;
                                    clicked => { root.open_channel(ch.conversation_id); }
                                }
                            }
                            }
                        }
                    }
                    if root.tab == SidebarTab.Servers && !root.selected_server: VerticalLayout {
        opacity: 0;
        init => { self.opacity = 1; }
        animate opacity { duration: 140ms; }
                        padding: 16px;
                        spacing: 6px;
                        Text { text: "Pick a server on the left rail."; font-size: 13px; color: Theme.text-muted; }
                        Text { text: "Or press + to create / join."; font-size: Theme.text-sm; color: Theme.text-muted; }
                        // Stretchy spacer: keeps this all-fixed column
                        // height-unbounded so it can't clamp the window
                        // scene (see ResizeHandle in widgets.slint).
                        Rectangle {}
                    }

                    if root.tab == SidebarTab.Admin: VerticalLayout {
        opacity: 0;
        init => { self.opacity = 1; }
        animate opacity { duration: 140ms; }
                        padding: 12px;
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 6px;
                            StatsChip { label: "Users"; value: root.admin_total_users; }
                            StatsChip { label: "Online"; value: root.admin_online; }
                            StatsChip { label: "Staff"; value: root.admin_staff; }
                            StatsChip { label: "Banned"; value: root.admin_banned; }
                            StatsChip { label: "Bots"; value: root.admin_bots; }
                            StatsChip { label: "Servers"; value: root.admin_servers; }
                        }
                        if root.admin_reports_status != "": Text { text: root.admin_reports_status; font-size: 11px; color: Theme.text-muted; }
                        if root.admin_reports.length > 0: Text { text: "Reports (\{root.admin_reports.length})"; font-size: 12px; font-family: Theme.font-medium; color: Theme.warning; }
                        if root.admin_reports.length > 0: ListView {
                            height: 180px;
                            for r in root.admin_reports: Rectangle {
                                background: Theme.bg-tertiary;
                                border-width: 1px;
                                border-color: Theme.border;
                                height: report_col.preferred-height + 12px;
                                report_col := VerticalLayout {
                                    x: 6px;
                                    width: parent.width - 12px;
                                    y: 6px;
                                    spacing: 3px;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text { text: r.reason; font-size: 11px; color: Theme.warning; horizontal-stretch: 1; }
                                        Text { text: r.age_label; font-size: 10px; color: Theme.text-muted; vertical-alignment: center; }
                                    }
                                    Text { text: "\{r.reporter_username} reported \{r.author_username} in \{r.conversation_label}"; font-size: 11px; color: Theme.text-muted; wrap: word-wrap; }
                                    Text { text: r.message_body; font-size: 12px; color: Theme.text-primary; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        SmallButton { text: "Actioned"; bg: Theme.danger-soft; fg: Theme.danger; clicked => { root.admin_resolve_report(r.report_id, "actioned"); } }
                                        SmallButton { text: "Dismiss"; clicked => { root.admin_resolve_report(r.report_id, "dismissed"); } }
                                    }
                                }
                            }
                        }
                        TextInputField { placeholder: "Search users..."; value <=> root.admin_search; edited(t) => { root.admin_search_changed(t); } }
                        if root.admin_status != "": Text { text: root.admin_status; font-size: 11px; color: Theme.text-muted; }
                        if root.admin_users.length == 0: EmptyState { text: "No users found."; box-height: 72px; }
                        list_admin := ListView {
                            vertical-stretch: 1;
                            for u in root.admin_users: PersonCard {
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: "\{u.display_name} (@\{u.username})"; font-size: 13px; color: Theme.text-primary; horizontal-stretch: 1; }
                                    if u.badge_text != "": Rectangle {
                                        background: u.badge_bg;
                                        height: 16px;
                                        border-radius: Theme.radius-sm;
                                        width: admin-badge.preferred-width + 8px;
                                        admin-badge := Text { text: u.badge_text; font-size: 9px; color: u.badge_fg; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                                Text { text: u.status_line; font-size: 11px; color: Theme.text-muted; }
                                HorizontalLayout {
                                    spacing: 6px;
                                    if root.is_admin && !u.role_locked: SmallButton { text: "User"; clicked => { root.admin_set_role(u.user_id, "user"); } }
                                    if root.is_admin && !u.role_locked: SmallButton { text: "Mod"; clicked => { root.admin_set_role(u.user_id, "moderator"); } }
                                    if root.is_admin && !u.role_locked: SmallButton { text: "Admin"; bg: Theme.accent-soft; clicked => { root.admin_set_role(u.user_id, "admin"); } }
                                    if !u.role_locked: SmallButton { text: u.banned ? "Unban" : "Ban"; bg: Theme.danger-soft; fg: Theme.danger; clicked => { root.admin_set_banned(u.user_id, !u.banned); } }
                                    if u.role_locked: Text { text: "rank locked"; font-size: Theme.text-xs; color: Theme.warning; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }

                // ---- Account footer: Discord-style user panel ----
                // Avatar with a round status dot, display name (+ badge),
                // status line, and icon-only mic / deafen / settings
                // buttons on the right.
                Rectangle {
                    height: 56px;
                    background: Theme.bg-tertiary;
                    // Top hairline instead of the old full border, so the
                    // panel reads as a strip of the sidebar, not a card.
                    Rectangle { x: 0; y: 0; width: parent.width; height: 1px; background: Theme.border-hairline; }

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 6px;
                        spacing: 8px;

                        // Avatar with a Discord-style round status dot
                        // ringed by the panel background. The panel draws
                        // its own oversized 14px dot here instead of
                        // Avatar's built-in 10px PresenceDot (also round,
                        // just smaller) for the chunkier Discord look.
                        Rectangle {
                            width: 34px;
                            height: 34px;
                            Avatar {
                                size: 32px;
                                initial: root.my_initial;
                                avatar-color: root.my_avatar_color;
                                photo-source: root.my_photo;
                            }
                            Rectangle {
                                x: parent.width - 14px;
                                y: parent.height - 14px;
                                width: 14px;
                                height: 14px;
                                border-radius: 7px;
                                background: Theme.bg-tertiary;
                                Rectangle {
                                    x: 3px;
                                    y: 3px;
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: root.my_presence_status == "online" ? Theme.online
                                        : (root.my_presence_status == "idle" ? Theme.idle
                                        : (root.my_presence_status == "dnd" ? Theme.dnd : Theme.offline));
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 1px;
                            // Fixed column width so a long name elides
                            // instead of pushing the buttons off-panel.
                            width: max(48px, root.panel_width - 196px);
                            HorizontalLayout {
                                spacing: 6px;
                                Text { text: root.my_display_name; font-size: 13px; font-family: Theme.font-medium; color: Theme.text-primary; overflow: elide; vertical-alignment: center; }
                                if root.my_badge_text != "": Rectangle {
                                    background: root.my_badge_bg;
                                    height: 14px;
                                    border-radius: Theme.radius-sm;
                                    width: my-badge-label.preferred-width + 8px;
                                    my-badge-label := Text { text: root.my_badge_text; font-size: 9px; color: root.my_badge_fg; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                            // NOTE: Discord shows "nick#tag" here; the data
                            // model has no tag field yet (see report), so
                            // this stays a presence status line.
                            Text { text: root.my_presence_label; font-size: Theme.text-xs; color: Theme.text-muted; overflow: elide; }
                        }

                        // Spacer pushes the icon buttons to the right edge.
                        Rectangle { horizontal-stretch: 1; }

                        PanelButton {
                            // Deafening also slashes the mic, like Discord.
                            toggled: root.mic_muted || root.deafened;
                            clicked => { root.toggle_mute(); }
                            MicGlyph { x: 8px; y: 8px; fg: parent.fg; }
                        }
                        PanelButton {
                            toggled: root.deafened;
                            clicked => { root.toggle_deafen(); }
                            HeadphonesGlyph { x: 8px; y: 8px; fg: parent.fg; }
                        }
                        PanelButton {
                            clicked => { root.open_settings(); }
                            GearGlyph { x: 8px; y: 8px; fg: parent.fg; }
                        }
                    }
                }
            }
        }

        ResizeHandle {
            drag-started => { root.resize_started(); }
            drag-moved(x) => { root.resize_moved(x); }
            drag-ended => { root.resize_ended(); }
        }
    }
}
