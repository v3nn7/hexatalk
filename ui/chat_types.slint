// Plain view-model structs for the chat screen. Mirrors src/types.rs
// domain rows, but pre-flattened to what Slint delegates need to render
// directly (display strings, colors, booleans already computed in Rust --
// see src/viewmodel.rs) rather than raw domain data.

export struct ReactionRow {
    emoji: string,
    count: int,
    reacted_by_me: bool,
}

export struct RoleTagRow {
    name: string,
    color: color,
}

// NOTE for the Rust view-model side (src/ui/viewmodel.rs): the Discord-style
// chat UI would benefit from two extra fields here -- `author_name_color:
// color` (role-based nick color; message_row.slint currently falls back to
// `author_avatar_color`) and `is_date_divider: bool` (date separators are
// currently encoded as `is_call_log` rows with an empty author, so they
// share rendering with real call-log lines). They were NOT added yet because
// viewmodel.rs constructs ChatMessageRow field-by-field without
// `..Default::default()`, so new fields must land together with the Rust
// update.
export struct ChatMessageRow {
    id: string,
    author_id: string,
    author_name: string,
    author_initial: string,
    author_avatar_color: color,
    author_photo: image,
    author_photo_url: string,
    is_bot: bool,
    // HexaTalk Plus cosmetic badge on the author line.
    is_plus: bool,
    mine: bool,
    encrypted: bool,
    is_call_log: bool,
    grouped: bool,
    meta: string,
    reply_line: string,
    body: string,
    body_danger: bool,
    has_attachment: bool,
    attachment_loading: bool,
    attachment: image,
    attachment_url: string,
    reactions: [ReactionRow],
    can_edit: bool,
    can_delete: bool,
    can_purge: bool,
    can_react: bool,
    can_report: bool,
    // True while this message's report-reason picker is open.
    reporting: bool,
    // Discord-style mention highlight: `mentions_me` = body pings the
    // current user, `mentions_everyone` = body contains @everyone in a
    // channel/group. `ping_label` is "pinged 5m ago"-style text ("" = no ping).
    mentions_me: bool,
    mentions_everyone: bool,
    ping_label: string,
}

// One row of the header pinned-messages panel (flat projection of a pinned
// ChatMessage -- see viewmodel::pinned_rows).
export struct PinnedMessageRow {
    id: string,
    author_name: string,
    author_avatar_color: color,
    meta: string,
    body: string,
}

export struct ReportRow {
    report_id: string,
    conversation_label: string,
    reporter_username: string,
    author_username: string,
    message_body: string,
    reason: string,
    age_label: string,
}

export struct ConversationRow {
    id: string,
    title: string,
    unread: bool,
    active: bool,
    /// Official HexaTalk Support inbox — show SUPPORT badge.
    is_support: bool,
}

