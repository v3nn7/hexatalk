                respond_request(rid, uid, ok) => { root.chat_respond_request(rid, uid, ok); }
                accept_all => { root.chat_accept_all(); }
                decline_all => { root.chat_decline_all(); }
                cancel_outgoing(rid) => { root.chat_cancel_outgoing(rid); }
                toggle_server_settings => { root.chat_toggle_server_settings(); }
                copy_invite_link(code) => { root.chat_copy_invite_link(code); }
                toggle_new_channel => { root.chat_toggle_new_channel(); }
                open_channel(id) => { root.chat_open_channel(id); }
                admin_search_changed(t) => { root.chat_admin_search_changed(t); }
                admin_set_role(id, role) => { root.chat_admin_set_role(id, role); }
                admin_set_banned(id, b) => { root.chat_admin_set_banned(id, b); }
                open_settings => { root.chat_open_settings(); }
                resize_started => { root.chat_sidebar_resize_started(); }
                resize_moved(x) => { root.chat_sidebar_resize_moved(x); }
                resize_ended => { root.chat_sidebar_resize_ended(); }
            }

            ChatArea {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                has_conversation: root.chat_has_conversation;
                loading: root.chat_history_loading;
                peer_title: root.chat_peer_title;
                peer_initial: root.chat_peer_initial;
                peer_avatar_color: root.chat_peer_avatar_color;
                peer_photo: root.chat_peer_photo;
                peer_online: root.chat_peer_online;
                is_channel_icon: root.chat_is_channel_icon;
                is_voice_icon: root.chat_is_voice_icon;
                is_direct: root.chat_is_direct;
                peer_connected: root.chat_peer_connected;
                connection_label: root.chat_connection_label;
                sas_label: root.chat_sas_label;
                show_call_button: root.chat_show_call_button;
                is_server_channel: root.chat_is_server_channel;
                channel_muted: root.chat_channel_muted;
                store_enabled: root.chat_store_enabled;
                store_allowed: root.chat_store_allowed;
                clear_chat_busy: root.chat_clear_chat_busy;
                clear_chat_confirm: root.chat_clear_chat_confirm;
                can_voice: root.chat_can_voice;
                in_voice: root.chat_in_voice;
                room_voice_status: root.chat_room_voice_status;
                voice_users_label: root.chat_voice_users_label;
                voice_users: root.chat_voice_users;
                messages: root.chat_messages;
                quick_emojis: root.chat_quick_emojis;
                scroll_pulse: root.chat_scroll_pulse;
                is_editing: root.chat_is_editing;
                input_placeholder: root.chat_input_placeholder;
                send_label: root.chat_send_label;
                crypto_ready: root.chat_crypto_ready;
                message_input <=> root.chat_message_input;
                mention_suggestions: root.chat_mention_suggestions;
                has_pending_attachment: root.chat_has_pending_attachment;
                pending_attachment_preview: root.chat_pending_attachment_preview;
                has_pending_reply: root.chat_has_pending_reply;
                pending_reply_line: root.chat_pending_reply_line;
                typing_line: root.chat_typing_line;
                chat_error: root.chat_error_line;
                warning_line: root.chat_warning_line;

                start_call => { root.chat_start_call(); }
                toggle_store => { root.chat_toggle_store(); }
                toggle_channel_mute => { root.chat_toggle_channel_mute(); }
                toggle_clear_confirm => { root.chat_toggle_clear_confirm(); }
                confirm_clear => { root.chat_confirm_clear(); }
                join_voice => { root.chat_join_voice(); }
                leave_voice => { root.chat_leave_voice(); }
                toggle_pins => { root.chat_toggle_pins(); }
                toggle_member_list => { root.chat_toggle_members(); }
                message_input_edited(t) => { root.chat_message_input_edited(t); }
                mention_pick(name) => { root.chat_mention_pick(name); }
                send => { root.chat_send(); }
                pick_attachment => { root.chat_pick_attachment(); }
                remove_attachment => { root.chat_remove_attachment(); }
                cancel_edit => { root.chat_cancel_edit(); }
                cancel_reply => { root.chat_cancel_reply(); }
                react(id, emoji) => { root.chat_react(id, emoji); }
                reply(id, author, snippet) => { root.chat_reply(id, author, snippet); }
                copy(text) => { root.chat_copy(text); }
                edit(id, body, enc) => { root.chat_edit(id, body, enc); }
                delete(id) => { root.chat_delete(id); }
                purge(id) => { root.chat_purge(id); }
                open_attachment(url) => { root.chat_open_attachment(url); }
                report(id) => { root.chat_report(id); }
                report_reason(id, body, reason) => { root.chat_report_reason(id, body, reason); }
                report_cancel(id) => { root.chat_report_cancel(id); }
                voice_volume_changed(id, v) => { root.chat_voice_volume_changed(id, v); }
            }

            if root.chat_selected_server: MembersDrawer {
                collapsed: root.chat_members_collapsed;
                panel_width: root.chat_members_width;
                total_count: root.chat_members_total;
                online_count: root.chat_members_online;
                online_members: root.chat_members_online_list;
                offline_members: root.chat_members_offline_list;
                bot_members: root.chat_members_bot_list;
                toggle => { root.chat_toggle_members(); }
                open_profile(id) => { root.chat_open_profile(id); }
                resize_started => { root.chat_members_resize_started(); }
                resize_moved(x) => { root.chat_members_resize_moved(x); }
                resize_ended => { root.chat_members_resize_ended(); }
            }
        }
        }

        // Rail button tooltips. Painted here -- after the whole chat layout
        // -- because a tooltip drawn inside the 72px rail would end up under
        // the sidebar, and a layout child can't take an explicit x/y, so
        // this sits as a plain (non-layout) sibling of ChatLayout instead.
        // The rail only reports which button is hovered (`hovered_tooltip`)
        // and its y position within the rail (`tooltip_y`); the call
        // banner's height is the rail's window-y.
        if rail.hovered_tooltip != "": Tooltip {
            text: rail.hovered_tooltip;
            x: 80px;
            y: call_banner.height + rail.tooltip_y + 11px;
        }
    }

    // Global Escape key (closes the attachment lightbox, cancels confirms,
    // etc. -- see Message::EscapePressed in update.rs). A transparent
    // overlay FocusScope: doesn't block clicks (no TouchArea of its own),
    // just listens for Escape when nothing more specific has focus.
    // Ctrl+K opens the command palette / message search.
    callback escape_pressed;
    callback open_command_palette;
    in property <bool> command_palette_open: false;
    in-out property <string> command_palette_query;
    in property <[string]> command_palette_results: [];
    callback command_palette_query_changed(string);
    callback command_palette_pick(int);
    callback command_palette_close;

    // ---- Global toast + attachment lightbox ----
    // Toast text comes from App::toast (Rust auto-clears it after 3s on the
    // Tick); clicking the pill dismisses it immediately (ClearToast).
    in property <string> toast_text;
    callback toast_dismissed;
    // Full-screen image preview (Message::OpenAttachmentPreview /
    // CloseAttachmentPreview); Escape is handled on the Rust side.
    in property <bool> attachment_preview_open: false;
    in property <image> attachment_preview;
    callback attachment_preview_close;

    // ---- vyrapp:// deep-link join confirmation ----
    // Populated from `servers:resolveCustomSlug` once a `vyrapp://join/<slug>`
    // link resolves (Message::DeepLinkReceived / DeepLinkResolved); always a
    // confirm step, never an auto-join, whether the app was already running
    // or just launched by the link.
    in property <bool> join_dialog_open: false;
    in property <string> join_dialog_server_name;
    in property <string> join_dialog_server_initial;
    in property <image> join_dialog_server_icon;
    in property <bool> join_dialog_invites_paused: false;
    callback join_dialog_confirm;
    callback join_dialog_dismiss;

    escape_scope := FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.escape_pressed();
                accept
            } else if (event.modifiers.control && event.text == "k") {
                root.open_command_palette();
                accept
            } else {
                reject
            }
        }
    }

    // Command palette / message search overlay (Ctrl+K).
    if root.command_palette_open: Rectangle {
        width: size_ref.width;
        height: size_ref.height;
        background: #00000088;
        TouchArea { clicked => { root.command_palette_close(); } }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height * 0.12;
            width: min(560px, parent.width - 48px);
            height: min(420px, parent.height * 0.7);
            background: Theme.bg-elevated;
            border-width: 1px;
            border-color: Theme.border-strong;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text {
                    text: "Search messages & jump";
                    font-size: 14px;
                    font-family: Theme.font-medium;
                    color: Theme.text-primary;
                }
                Text {
                    text: "Type at least 2 characters. Encrypted history is skipped.";
                    font-size: 11px;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
                palette_input := TextInputField {
                    placeholder: "Search…";
                    value <=> root.command_palette_query;
                    edited(t) => { root.command_palette_query_changed(t); }
                    // Enter picks the top result, like every command
                    // palette; Escape/overlay-click still closes.
                    submitted => {
                        if (root.command_palette_results.length > 0) {
                            root.command_palette_pick(0);
                        }
                    }
                    // Auto-focus the search field when the palette opens
                    // (this subtree is created with the overlay).
                    init => { self.focus-input(); }
                }
                Flickable {
                    vertical-stretch: 1;
                    viewport-height: results_col.preferred-height;
                    results_col := VerticalLayout {
                        width: parent.width;
                        spacing: 4px;
                        if root.command_palette_results.length == 0: Text {
                            text: "No results yet.";
                            font-size: 12px;
                            color: Theme.text-muted;
                        }
                        for r[i] in root.command_palette_results: Rectangle {
                            height: 40px;
                            background: rt.has-hover ? Theme.bg-hover : transparent;
                            animate background { duration: 120ms; }
                            rt := TouchArea { clicked => { root.command_palette_pick(i); } }
                            Text {
                                x: 8px;
                                width: parent.width - 16px;
                                height: parent.height;
                                text: r;
                                font-size: 12px;
                                color: Theme.text-primary;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }

    // Add/join-server popup: a window-level overlay centered on screen
    // (same pattern as the command-palette popup above), rather than an
    // inline sidebar panel -- keeps it visible and correctly placed no
    // matter how narrow the window gets resized.
    if root.chat_add_menu_open: Rectangle {
        width: size_ref.width;
        height: size_ref.height;
        background: #00000088;
        TouchArea { clicked => { root.chat_toggle_add_menu(); } }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(340px, parent.width - 48px);
            height: add_menu_col.preferred-height + 32px;
            background: Theme.bg-elevated;
            border-width: 1px;
            border-color: Theme.border-strong;
            border-radius: Theme.radius-md;
            add_menu_col := VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text { text: "ADD SERVER"; font-size: Theme.text-xs; font-family: Theme.font-medium; letter-spacing: 1px; color: Theme.text-link; }
                TextInputField { placeholder: "Name"; value <=> root.chat_new_server_name; edited(t) => { root.chat_new_server_name_changed(t); } submitted => { root.chat_create_server(); } }
                PrimaryButton { text: "Create"; clicked => { root.chat_create_server(); } }
                Rectangle { height: 1px; background: Theme.border; }
                TextInputField { placeholder: "Invite code or link"; value <=> root.chat_join_server_code; edited(t) => { root.chat_join_server_code_changed(t); } submitted => { root.chat_join_server(); } }
                SecondaryButton { text: "Join"; clicked => { root.chat_join_server(); } }
                if root.chat_server_status != "": Text { text: root.chat_server_status; font-size: 11px; color: Theme.text-muted; wrap: word-wrap; }
                SmallButton { text: "Close"; clicked => { root.chat_toggle_add_menu(); } }
            }
        }
    }

    // Create-channel modal (Discord-style): window-level dim overlay like
    // the add/join-server popup above. Channel type is a pair of radio
    // cards; the name field shows a "#" prefix for text channels and the
    // input itself is already Discord-formatted live by the Rust side
    // (lowercase, spaces -> dashes). Enter submits, Escape closes (global
    // Escape handler), click-away cancels.
    if root.chat_new_channel_open: Rectangle {
        width: size_ref.width;
        height: size_ref.height;
        background: #00000088;
        TouchArea { clicked => { root.chat_toggle_new_channel(); } }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(400px, parent.width - 48px);
            height: new_channel_col.preferred-height + 32px;
            background: Theme.bg-elevated;
            border-width: 1px;
            border-color: Theme.border-strong;
            border-radius: Theme.radius-md;
            new_channel_col := VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text { text: "CREATE CHANNEL"; font-size: Theme.text-xs; font-family: Theme.font-medium; letter-spacing: 1px; color: Theme.text-link; }

                FieldLabel { text: "CHANNEL TYPE"; }
                // Text radio card.
                Rectangle {
                    height: text_card_col.preferred-height + 20px;
                    border-radius: Theme.radius-md;
                    border-width: 1px;
                    border-color: !root.chat_new_channel_is_voice ? Theme.accent : Theme.border;
                    background: !root.chat_new_channel_is_voice ? Theme.accent-soft : Theme.bg-control;
                    animate border-color { duration: 120ms; }
                    animate background { duration: 120ms; }
                    TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.chat_set_new_channel_voice(false); } }
                    text_card_col := HorizontalLayout {
                        padding: 10px;
                        spacing: 12px;
                        Text { text: "#"; font-size: 20px; font-family: Theme.font-medium; color: !root.chat_new_channel_is_voice ? Theme.accent : Theme.text-muted; vertical-alignment: center; horizontal-stretch: 0; }
                        VerticalLayout {
                            spacing: 2px;
                            alignment: center;
                            Text { text: "Text"; font-size: Theme.text-md; font-family: Theme.font-medium; color: Theme.text-bright; }
                            Text { text: "Send messages, images, GIFs, emoji, opinions and puns"; font-size: Theme.text-sm; color: Theme.text-muted; wrap: word-wrap; }
                        }
                    }
                }
                // Voice radio card.
                Rectangle {
                    height: voice_card_col.preferred-height + 20px;
                    border-radius: Theme.radius-md;
                    border-width: 1px;
                    border-color: root.chat_new_channel_is_voice ? Theme.accent : Theme.border;
                    background: root.chat_new_channel_is_voice ? Theme.accent-soft : Theme.bg-control;
                    animate border-color { duration: 120ms; }
                    animate background { duration: 120ms; }
                    TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.chat_set_new_channel_voice(true); } }
                    voice_card_col := HorizontalLayout {
                        padding: 10px;
                        spacing: 12px;
                        Text { text: "🔊"; font-size: 18px; vertical-alignment: center; horizontal-stretch: 0; }
                        VerticalLayout {
                            spacing: 2px;
                            alignment: center;
                            Text { text: "Voice"; font-size: Theme.text-md; font-family: Theme.font-medium; color: Theme.text-bright; }
                            Text { text: "Hang out together with voice and video"; font-size: Theme.text-sm; color: Theme.text-muted; wrap: word-wrap; }
                        }
                    }
                }

                FieldLabel { text: "CHANNEL NAME"; }
                HorizontalLayout {
                    spacing: 8px;
                    // "#" prefix for text channels; speaker glyph for voice.
                    Text {
                        text: root.chat_new_channel_is_voice ? "🔊" : "#";
                        font-size: Theme.text-md;
                        font-family: Theme.font-medium;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        horizontal-stretch: 0;
                    }
                    TextInputField {
                        placeholder: root.chat_new_channel_is_voice ? "Voice Lounge" : "new-channel";
                        value <=> root.chat_new_channel_name;
                        edited(t) => { root.chat_new_channel_name_changed(t); }
                        submitted => { if (root.chat_new_channel_name != "") { root.chat_create_channel(); } }
                    }
                }
                // Live preview of the final (formatted) name.
                Text {
                    text: root.chat_new_channel_name == "" ? (root.chat_new_channel_is_voice ? "🔊 Voice Lounge" : "# new-channel") : (root.chat_new_channel_is_voice ? "🔊 " + root.chat_new_channel_name : "# " + root.chat_new_channel_name);
                    font-size: 11px;
                    color: Theme.text-muted;
                }

                if root.chat_server_status != "": Text { text: root.chat_server_status; font-size: 11px; color: Theme.danger; wrap: word-wrap; }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    SecondaryButton { text: "Cancel"; width: 90px; clicked => { root.chat_toggle_new_channel(); } }
                    PrimaryButton { text: "Create"; width: 110px; enabled: root.chat_new_channel_name != ""; clicked => { root.chat_create_channel(); } }
                }
            }
        }
    }

    // vyrapp:// deep-link join confirmation -- same window-level dim-overlay
    // pattern as the add/join-server popup above, but click-away is not a
    // "Cancel" shortcut (an accidental miss-click shouldn't silently drop a
    // link the user just followed), so only the buttons and Escape dismiss it.
    if root.join_dialog_open: Rectangle {
        width: size_ref.width;
        height: size_ref.height;
        background: #00000088;
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(340px, parent.width - 48px);
            height: join_dialog_col.preferred-height + 32px;
            background: Theme.bg-elevated;
            border-width: 1px;
            border-color: Theme.border-strong;
            border-radius: Theme.radius-md;
            join_dialog_col := VerticalLayout {
                padding: 16px;
                spacing: 12px;
                Text { text: "JOIN SERVER"; font-size: Theme.text-xs; font-family: Theme.font-medium; letter-spacing: 1px; color: Theme.text-link; }
                HorizontalLayout {
                    spacing: 12px;
                    Rectangle {
                        width: 48px;
                        height: 48px;
                        horizontal-stretch: 0;
                        background: root.join_dialog_server_icon.width > 0 ? transparent : Theme.accent-soft;
                        border-radius: Theme.radius-md;
                        clip: true;
                        if root.join_dialog_server_icon.width > 0: Image { source: root.join_dialog_server_icon; width: 48px; height: 48px; image-fit: ImageFit.cover; }
                        if root.join_dialog_server_icon.width <= 0: Text {
                            text: root.join_dialog_server_initial;
                            font-size: 18px;
                            color: Theme.accent;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: root.join_dialog_server_name;
                        font-size: Theme.text-md;
                        font-family: Theme.font-medium;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
                if root.join_dialog_invites_paused: Text {
                    text: "Invites are currently paused for this server.";
                    font-size: 12px;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
                if !root.join_dialog_invites_paused: Text {
                    text: "Join this server?";
                    font-size: 13px;
                    color: Theme.text-primary;
                }
                HorizontalLayout {
                    spacing: 8px;
                    SecondaryButton { text: "Cancel"; clicked => { root.join_dialog_dismiss(); } }
                    if !root.join_dialog_invites_paused: PrimaryButton { text: "Join"; clicked => { root.join_dialog_confirm(); } }
                }
            }
        }
    }

    // Pinned-messages popover (channel-bar pin icon). Anchored top-right,
    // just under the 48px channel bar; a transparent full-window backdrop
    // closes it on click-away (popover, not a modal -- no dim).
    if root.chat_pins_open: Rectangle {
        width: size_ref.width;
        height: size_ref.height;
        TouchArea { clicked => { root.chat_toggle_pins(); } }
        Rectangle {
            x: size_ref.width - self.width - 16px;
            y: 56px;
            width: min(360px, size_ref.width - 32px);
            height: min(440px, size_ref.height - 72px);
            background: Theme.bg-elevated;
            border-width: 1px;
            border-color: Theme.border-strong;
            border-radius: Theme.radius-md;
            drop-shadow-offset-y: Theme.shadow-offset;
            drop-shadow-color: Theme.shadow-color;
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                HorizontalLayout {
                    Text {
                        text: "Pinned messages";
                        font-size: Theme.text-md;
                        font-family: Theme.font-medium;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    SmallButton { text: "Close"; clicked => { root.chat_toggle_pins(); } }
                }
                Rectangle { height: 1px; background: Theme.border-hairline; }
                if root.chat_pinned_messages.length == 0: Text {
                    text: "No pinned messages yet.";
                    font-size: Theme.text-sm;
                    color: Theme.text-muted;
                }
                Flickable {
                    vertical-stretch: 1;
                    viewport-height: pins_col.preferred-height;
                    pins_col := VerticalLayout {
                        width: parent.width;
                        spacing: 8px;
                        for p in root.chat_pinned_messages: Rectangle {
                            background: Theme.bg-tertiary;
                            border-width: 1px;
                            border-color: Theme.border;
                            border-radius: Theme.radius-sm;
                            height: pin_col.preferred-height + 16px;
                            pin_col := VerticalLayout {
                                x: 10px;
                                y: 8px;
                                width: parent.width - 20px;
                                spacing: 2px;
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: p.author_name;
                                        font-size: Theme.text-sm;
                                        font-family: Theme.font-medium;
                                        color: p.author_avatar_color;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: p.meta;
                                        font-size: Theme.text-xs;
                                        color: Theme.text-muted;
                                        vertical-alignment: center;
                                    }
                                }
                                Text {
                                    text: p.body;
                                    font-size: Theme.text-sm;
                                    color: Theme.text-primary;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Full-screen attachment lightbox (OpenAttachmentPreview): dark
    // backdrop, contain-fit image, click or Escape (handled in Rust via
    // Message::EscapePressed) closes it.
    if root.attachment_preview_open: Rectangle {
        width: size_ref.width;
        height: size_ref.height;
        background: #000000cc;
        TouchArea { clicked => { root.attachment_preview_close(); } }
        if root.attachment_preview.width > 0: Image {
            x: 32px;
            y: 32px;
            width: parent.width - 64px;
            height: parent.height - 64px;
            source: root.attachment_preview;
            image-fit: ImageFit.contain;
        }
        if root.attachment_preview.width <= 0: Text {
            x: (parent.width - self.preferred-width) / 2;
            y: (parent.height - self.preferred-height) / 2;
            text: "[image unavailable]";
            font-size: Theme.text-md;
            color: Theme.text-muted;
        }
    }

    // Global ephemeral toast (App::toast) -- bottom-center floating pill.
    // Rust clears the text after ~3s; clicking dismisses it immediately.
    if root.toast_text != "": Rectangle {
        x: (size_ref.width - self.width) / 2;
        y: size_ref.height - self.height - 40px;
        width: toast_label.preferred-width + 32px;
        height: 36px;
        border-radius: Theme.radius-md;
        background: Theme.bg-floating;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-offset-y: Theme.shadow-offset-light;
        drop-shadow-blur: Theme.shadow-blur;
        drop-shadow-color: Theme.shadow-color;
        toast_label := Text {
            width: parent.width;
            height: parent.height;
            text: root.toast_text;
            font-size: Theme.text-sm;
            font-family: Theme.font-medium;
            color: Theme.text-primary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.toast_dismissed(); }
        }
    }
}
