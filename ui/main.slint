    // ---- Call banner ----
    in property <bool> chat_call_visible: false;
    in property <bool> chat_call_ringing: false;
    in property <bool> chat_call_incoming: false;
    in property <bool> chat_call_active: false;
    in property <string> chat_call_label;
    in property <bool> chat_call_muted: false;
    in property <bool> chat_call_all_muted: false;
    in property <bool> chat_is_sharing: false;
    in property <bool> chat_share_picker_open: false;
    in property <[ShareTargetRow]> chat_share_targets: [];
    in property <bool> chat_has_remote_frame: false;
    in property <image> chat_remote_frame;
    in property <string> chat_remote_frame_title;
    in property <bool> chat_share_expanded: false;
    in property <float> banner_peer_volume: 1.0;
    in property <string> chat_share_stats_line;
    in property <bool> chat_remote_stream_muted: false;
    in property <bool> chat_share_system_audio: true;

    callback chat_call_accept;
    callback chat_call_decline;
    callback chat_call_hang_up;
    callback chat_call_toggle_mute;
    callback chat_call_toggle_mute_all;
    callback chat_toggle_share_picker;
    callback chat_stop_share;
    callback chat_start_share(string);
    callback chat_toggle_share_size;
    callback chat_toggle_stream_mute;
    callback chat_toggle_share_system_audio;

    if root.current-screen == Screen.Chat: Rectangle {
        // Window has several mutually-exclusive top-level screen children
        // plus the always-present `escape_scope` FocusScope below, so the
        // "lone unsized child fills its parent" default doesn't reliably
        // kick in -- each screen must bind explicitly to the window's own
        // size (see the same pattern on Auth/Profile/Settings/ServerSettings
        // above) or it renders at its content's natural size instead of
        // filling the actual window.
        width: size_ref.width;
        height: size_ref.height;
        ChatLayout := VerticalLayout {
            call_banner := CallBanner {
            visible_: root.chat_call_visible;
            is_ringing: root.chat_call_ringing;
            is_incoming: root.chat_call_incoming;
            is_active: root.chat_call_active;
            label: root.chat_call_label;
            muted: root.chat_call_muted;
            all_muted: root.chat_call_all_muted;
            is_sharing: root.chat_is_sharing;
            share_picker_open: root.chat_share_picker_open;
            share_targets: root.chat_share_targets;
            has_remote_frame: root.chat_has_remote_frame;
            remote_frame: root.chat_remote_frame;
            remote_frame_title: root.chat_remote_frame_title;
            share_expanded: root.chat_share_expanded;
            peer_volume: root.banner_peer_volume;
            share_stats_line: root.chat_share_stats_line;
            remote_stream_muted: root.chat_remote_stream_muted;
            share_system_audio: root.chat_share_system_audio;
            accept => { root.chat_call_accept(); }
            decline => { root.chat_call_decline(); }
            hang_up => { root.chat_call_hang_up(); }
            toggle_mute => { root.chat_call_toggle_mute(); }
            toggle_mute_all => { root.chat_call_toggle_mute_all(); }
            toggle_share_picker => { root.chat_toggle_share_picker(); }
            stop_share => { root.chat_stop_share(); }
            start_share(id) => { root.chat_start_share(id); }
            toggle_share_size => { root.chat_toggle_share_size(); }
            volume_changed(v) => { root.chat_voice_volume_changed("*", v); }
            toggle_stream_mute => { root.chat_toggle_stream_mute(); }
            toggle_share_system_audio => { root.chat_toggle_share_system_audio(); }
        }

        HorizontalLayout {
            vertical-stretch: 1;

            rail := ServerRail {
                home_active: root.chat_home_active;
                unread_count: root.chat_unread_count;
                servers: root.chat_servers;
                add_menu_open: root.chat_add_menu_open;
                friends_online: root.chat_friends_online;
                friends_active: root.chat_friends_active;
                incoming_count: root.chat_incoming_count;
                requests_active: root.chat_requests_active;
                show_admin: root.chat_show_admin_tab;
                admin_active: root.chat_admin_active;
                go_home => { root.chat_go_home(); }
                select_server(id) => { root.chat_select_server(id); }
                toggle_add_menu => { root.chat_toggle_add_menu(); }
                open_friends => { root.chat_open_friends(); }
                open_requests => { root.chat_open_requests(); }
                open_admin => { root.chat_open_admin(); }
            }

            Sidebar {
                tab: root.chat_tab;
                tab_title: root.chat_tab_title;
                selected_server: root.chat_selected_server;
                panel_width: root.chat_sidebar_width;
                server_status: root.chat_server_status;
                new_group_open: root.chat_new_group_open;
                new_group_name <=> root.chat_new_group_name;
                group_candidates: root.chat_group_candidates;
                group_create_status: root.chat_group_create_status;
                conversations: root.chat_conversations;
                friends_summary: root.chat_friends_summary;
                add_friend_input <=> root.chat_add_friend_input;
                add_friend_note <=> root.chat_add_friend_note;
                add_friend_status: root.chat_add_friend_status;
                friends_filter: root.chat_friends_filter;
                people_hits: root.chat_people_hits;
                suggestions: root.chat_suggestions;
                friends_filter_input <=> root.chat_friends_filter_input;
                friends: root.chat_friends;
                blocked: root.chat_blocked;
                confirm_block_user_id: root.chat_confirm_block_user_id;
                friend_request_busy: root.chat_friend_request_busy;
                incoming_requests: root.chat_incoming_requests;
                outgoing_requests: root.chat_outgoing_requests;
                server_name: root.chat_server_name;
                server_meta: root.chat_server_meta;
                can_manage_server: root.chat_can_manage_server;
                invite_code: root.chat_invite_code;
                can_manage_channels: root.chat_can_manage_channels;
                text_channels: root.chat_text_channels;
                voice_channels: root.chat_voice_channels;
                admin_search <=> root.chat_admin_search;
                admin_status: root.chat_admin_status;
                admin_users: root.chat_admin_users;
                is_admin: root.chat_is_admin;
                admin_total_users: root.chat_admin_total_users;
                admin_online: root.chat_admin_online;
