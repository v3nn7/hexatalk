    // ==================== Chat screen ====================
    // See rail.slint / sidebar.slint / chat_area.slint / members.slint /
    // call_banner.slint -- port of src/view/chat.rs (2698 lines in iced).
    // Composed directly here (no extra chat.slint wrapper) to avoid a
    // second full layer of property/callback forwarding.

    // ---- Rail ----
    in property <bool> chat_home_active: false;
