                admin_reports: root.chat_admin_reports;
                admin_reports_status: root.chat_admin_reports_status;
                admin_resolve_report(id, status) => { root.chat_admin_resolve_report(id, status); }
                my_display_name: root.chat_my_display_name;
                my_initial: root.chat_my_initial;
                my_avatar_color: root.chat_my_avatar_color;
                my_photo: root.chat_my_photo;
                my_badge_text: root.chat_my_badge_text;
                my_badge_bg: root.chat_my_badge_bg;
                my_badge_fg: root.chat_my_badge_fg;
                my_presence_status: root.chat_my_presence_status;
                my_presence_label: root.chat_my_presence_label;
                mic_muted: root.chat_mic_muted;
                deafened: root.chat_deafened;
                toggle_mute => { root.chat_toggle_mute(); }
                toggle_deafen => { root.chat_toggle_deafen(); }

                toggle_group_panel => { root.chat_toggle_group_panel(); }
                group_name_changed(t) => { root.chat_group_name_changed(t); }
                toggle_group_member(id) => { root.chat_toggle_group_member(id); }
                create_group => { root.chat_create_group(); }
                open_conversation(id) => { root.chat_open_conversation(id); }
                add_friend_input_changed(t) => { root.chat_add_friend_input_changed(t); }
                add_friend_note_changed(t) => { root.chat_add_friend_note_changed(t); }
                send_friend_request => { root.chat_send_friend_request(); }
                set_friends_filter(i) => { root.chat_set_friends_filter(i); }
                friends_filter_input_changed(t) => { root.chat_friends_filter_input_changed(t); }
                open_profile(id) => { root.chat_open_profile(id); }
                send_friend_request_to(u) => { root.chat_send_friend_request_to(u); }
                message_friend(id) => { root.chat_message_friend(id); }
                toggle_favorite(id) => { root.chat_toggle_favorite(id); }
                remove_friend(id) => { root.chat_remove_friend(id); }
                confirm_block(id) => { root.chat_confirm_block(id); }
