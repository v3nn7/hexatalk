// Root window. Composes every screen; `current-screen` (driven from Rust)
// picks which one is visible. Screens are added incrementally as they're
// ported off iced -- see the per-screen .slint files in this directory.
//
// Font imports embed the file at compile time and register it under its
// own font-family name ("Roboto" / "Roboto Medium") -- Slint's recommended
// way to bundle custom fonts, no runtime registration needed.
import "../assets/fonts/Roboto-Regular.ttf";
import "../assets/fonts/Roboto-Medium.ttf";
import { Theme } from "theme.slint";
import { TextInputField, Tooltip, PrimaryButton, SecondaryButton, FieldLabel } from "widgets.slint";
import { AuthScreen, AuthMode } from "auth.slint";
import { EmailVerifyScreen } from "email_verify.slint";
import { ServerRail } from "rail.slint";
import { Sidebar, SidebarTab, SmallButton } from "sidebar.slint";
import { ChatArea } from "chat_area.slint";
import { MembersDrawer } from "members.slint";
import { CallBanner } from "call_banner.slint";
import { ProfileScreen } from "profile.slint";
import { SettingsScreen, SettingsCategory, BotRow, DeviceRow } from "settings.slint";
import { ServerSettingsScreen, ServerSettingsCategory } from "server_settings.slint";
import {
    SSChannelRow, SSMemberRow, SSRoleRow, SSPermRow,
    SSChannelRolePick, SSChannelOverwritePermRow,
} from "server_settings_types.slint";
import {
    ServerRow, ConversationRow, FriendRow, IncomingRequestRow, OutgoingRequestRow,
    PeopleHitRow, SuggestionRow, BlockedRow, ChannelRow, AdminUserRow, GroupCandidateRow,
    ChatMessageRow, MemberRow, ShareTargetRow, RoleTagRow, VoiceUserVolumeRow, ReportRow,
    PinnedMessageRow,
} from "chat_types.slint";

export { AuthMode, SidebarTab }

export enum Screen { Auth, EmailVerify, Chat, Profile, Settings, ServerSettings }

export component AppWindow inherits Window {
    title: "HexaTalk";
    background: Theme.bg-primary;
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 980px;
    min-height: 600px;
    default-font-family: Theme.font-body;

    in property <Screen> current-screen: Screen.Auth;

    // ---- Auth screen state (see auth.slint) ----
    in property <AuthMode> auth-mode: AuthMode.Login;
    in-out property <string> username-input;
    in-out property <string> password-input;
    in-out property <string> display-name-input;
    in-out property <string> email-input;
    in-out property <string> password-confirm-input;
    in-out property <string> password-reset-code-input;
    in property <bool> password-reset-code-sent: false;
    in property <string> auth-error;
    in property <string> auth-username-error;
    in property <string> auth-password-error;
    in property <string> auth-email-error;
    in property <bool> auth-busy;
    in property <string> connect-status;
    in property <string> app-version-line;

    callback auth-switch-mode(AuthMode);
    callback auth-username-changed(string);
    callback auth-password-changed(string);
    callback auth-display-name-changed(string);
    callback auth-email-changed(string);
    callback auth-password-confirm-changed(string);
    callback auth-password-reset-code-changed(string);
    callback auth-submit;
    // "Retry" on the connection-error screen -> Message::RetryConnect.
    callback auth-retry;

    // Passive, always-present sizing reference: a plain child of Window
    // with a `100%` binding, which is the ordinary unambiguous parent-fill
    // every other Rectangle in this codebase already relies on. Each screen
    // below binds its own width/height to `size_ref` instead of `root`,
    // because a Window's own `width`/`height` aren't a hard-set value here
    // -- only `preferred-width`/`min-width` hints are -- and binding
    // screens directly to `root.width` was observed resolving differently
    // between debug and release builds (correct in debug, collapsed to a
    // small natural size in release). It renders nothing and has no
    // TouchArea, so it doesn't intercept input or paint over the screens.
    size_ref := Rectangle {
        width: 100%;
        height: 100%;
    }

    if root.current-screen == Screen.Auth: AuthScreen {
        width: size_ref.width;
        height: size_ref.height;
        auth-mode: root.auth-mode;
        username-input <=> root.username-input;
        password-input <=> root.password-input;
        display-name-input <=> root.display-name-input;
        email-input <=> root.email-input;
        password-confirm-input <=> root.password-confirm-input;
        password-reset-code-input <=> root.password-reset-code-input;
        password-reset-code-sent: root.password-reset-code-sent;
        auth-error: root.auth-error;
        username-error: root.auth-username-error;
        password-error: root.auth-password-error;
        email-error: root.auth-email-error;
        auth-busy: root.auth-busy;
        connect-status: root.connect-status;
        app-version-line: root.app-version-line;
        switch-mode(mode) => { root.auth-switch-mode(mode); }
        submit => { root.auth-submit(); }
        retry => { root.auth-retry(); }
        username-edited(text) => { root.auth-username-changed(text); }
        password-edited(text) => { root.auth-password-changed(text); }
        display-name-edited(text) => { root.auth-display-name-changed(text); }
        email-edited(text) => { root.auth-email-changed(text); }
        password-confirm-edited(text) => { root.auth-password-confirm-changed(text); }
        password-reset-code-edited(text) => { root.auth-password-reset-code-changed(text); }
    }

    // ==================== Email verification gate ====================
    in-out property <string> email-verify-input;
    in-out property <string> email-verify-code-input;
    in property <bool> email-verify-code-sent: false;
    in property <string> email-verify-error;
    in property <bool> email-verify-busy: false;

    callback email-verify-email-changed(string);
    callback email-verify-send-code;
    callback email-verify-code-changed(string);
    callback email-verify-submit-code;
    callback email-verify-change-email;
    callback email-verify-log-out;

    if root.current-screen == Screen.EmailVerify: EmailVerifyScreen {
        width: size_ref.width;
        height: size_ref.height;
        email-input <=> root.email-verify-input;
        code-input <=> root.email-verify-code-input;
        code-sent: root.email-verify-code-sent;
        verify-error: root.email-verify-error;
        verify-busy: root.email-verify-busy;
        email-edited(text) => { root.email-verify-email-changed(text); }
        send-code => { root.email-verify-send-code(); }
        code-edited(text) => { root.email-verify-code-changed(text); }
        verify-code => { root.email-verify-submit-code(); }
        change-email => { root.email-verify-change-email(); }
        log-out => { root.email-verify-log-out(); }
    }

    // ==================== Profile screen ====================
    in property <bool> profile_loading: false;
    in property <string> profile_error_text;
    in property <string> profile_user_id;
    in property <string> profile_username;
    in property <string> profile_display_name;
    in property <string> profile_initial;
    in property <color> profile_avatar_color: Theme.accent;
    in property <image> profile_photo;
    in property <bool> profile_online: false;
    in property <string> profile_status_message;
    in property <string> profile_bio;
    in property <bool> profile_is_staff: false;
    in property <bool> profile_is_plus: false;
    in property <image> profile_banner_photo;
    in property <bool> profile_has_banner: false;
    in property <bool> profile_show_support_dm: false;
    in property <bool> profile_is_friend: false;
    in property <bool> profile_favorite: false;
    in property <string> profile_relation;
    in property <string> profile_request_id;
    in property <bool> profile_friend_request_busy: false;
    in property <bool> profile_can_moderate: false;
    in property <bool> profile_is_blocked: false;
    in property <bool> profile_confirm_block: false;
    in property <string> profile_mutual_servers_line;
    in property <bool> profile_has_role_info: false;
    in property <string> profile_role_section_title;
    in property <bool> profile_role_is_owner: false;
    in property <[RoleTagRow]> profile_role_badges: [];

    callback profile_back;
    callback profile_support_dm(string);
    callback profile_message_friend(string);
    callback profile_toggle_favorite(string);
    callback profile_respond_request(string);
    callback profile_send_friend_request(string);
    callback profile_unblock(string);
    callback profile_confirm_block_click(string);
    callback profile_block(string);
    callback profile_cancel_block;

    if root.current-screen == Screen.Profile: ProfileScreen {
        width: size_ref.width;
        height: size_ref.height;
        loading: root.profile_loading;
        error: root.profile_error_text;
        user_id: root.profile_user_id;
        username: root.profile_username;
        display_name: root.profile_display_name;
        initial: root.profile_initial;
        avatar_color: root.profile_avatar_color;
        photo: root.profile_photo;
        online: root.profile_online;
        status_message: root.profile_status_message;
        bio: root.profile_bio;
        is_staff: root.profile_is_staff;
        is_plus: root.profile_is_plus;
        banner_photo: root.profile_banner_photo;
        has_banner: root.profile_has_banner;
        show_support_dm: root.profile_show_support_dm;
        is_friend: root.profile_is_friend;
        favorite: root.profile_favorite;
        relation: root.profile_relation;
        request_id: root.profile_request_id;
        friend_request_busy: root.profile_friend_request_busy;
        can_moderate: root.profile_can_moderate;
        is_blocked: root.profile_is_blocked;
        confirm_block: root.profile_confirm_block;
        mutual_servers_line: root.profile_mutual_servers_line;
        has_role_info: root.profile_has_role_info;
        role_section_title: root.profile_role_section_title;
        role_is_owner: root.profile_role_is_owner;
        role_badges: root.profile_role_badges;
        back => { root.profile_back(); }
        support_dm(id) => { root.profile_support_dm(id); }
        message_friend(id) => { root.profile_message_friend(id); }
        toggle_favorite(id) => { root.profile_toggle_favorite(id); }
        respond_request(id) => { root.profile_respond_request(id); }
        send_friend_request(u) => { root.profile_send_friend_request(u); }
        unblock(id) => { root.profile_unblock(id); }
        confirm_block_click(id) => { root.profile_confirm_block_click(id); }
        block(id) => { root.profile_block(id); }
        cancel_block => { root.profile_cancel_block(); }
    }

    // ==================== Settings screen ====================
    in property <SettingsCategory> settings_category: SettingsCategory.Account;
    in property <string> settings_avatar_initial;
    in property <color> settings_avatar_color: Theme.accent;
    in property <image> settings_avatar_photo;
    in property <bool> settings_has_photo: false;
    in property <bool> settings_avatar_upload_busy: false;
    in-out property <string> settings_display_name_input;
    in-out property <string> settings_status_input;
    in-out property <string> settings_bio_input;
    in property <int> settings_selected_avatar_index: -1;
    in property <string> settings_profile_status;
    in property <bool> settings_profile_status_is_error: false;
    in-out property <string> settings_current_password_input;
    in-out property <string> settings_new_password_input;
    in-out property <string> settings_confirm_password_input;
    in property <string> settings_password_status;
    in property <bool> settings_password_status_is_error: false;
    in property <string> settings_my_badge_text;
    in property <color> settings_my_badge_bg;
    in property <color> settings_my_badge_fg;
    in property <bool> settings_store_chat_history: true;
    in property <bool> settings_hide_online_status: false;
    in property <bool> settings_friends_only_dms: false;
    in property <bool> settings_discoverable: true;
    in property <string> settings_friend_request_privacy_label;
    in property <string> settings_presence_status_label;
    in property <bool> settings_is_staff: false;
    in-out property <string> settings_new_bot_name_input;
    in property <string> settings_bot_token_reveal;
    in property <[BotRow]> settings_my_bots: [];
    in-out property <string> settings_bot_invite_username_input;
    in property <string> settings_bot_status;
    in property <bool> settings_bot_status_is_error: false;
    in property <[DeviceRow]> settings_input_devices: [];
    in property <[DeviceRow]> settings_output_devices: [];
    in property <float> settings_noise_gate: 0;
    in property <float> settings_ui_scale: 1;
    // Persisted zoom drives the Theme global (radius/spacing/font tokens
    // all derive from ui-scale). The settings slider writes the global
    // directly for live preview; this binding restores it at startup and
    // on every state sync.
    changed settings_ui_scale => { Theme.ui-scale = root.settings_ui_scale; }
    init => { Theme.ui-scale = root.settings_ui_scale; }
    in property <string> settings_noise_gate_label;
    in property <string> settings_version_line;
    in property <string> settings_vault_hint;
    in property <string> settings_update_check_status;
    in property <bool> settings_update_ready: false;
    in property <string> settings_ping_status;
    in property <bool> settings_plus_active: false;
    in property <string> settings_plus_status_line;
    in property <string> settings_plus_busy_status;
    in property <bool> settings_plus_checkout_busy: false;

    callback settings_close;
    callback settings_category_changed(SettingsCategory);
    callback settings_plus_subscribe;
    callback settings_plus_manage_billing;
    callback settings_plus_refresh;
    callback settings_pick_avatar;
    callback settings_remove_avatar;
    callback settings_display_name_changed(string);
    callback settings_status_changed(string);
    callback settings_bio_changed(string);
    callback settings_avatar_color_selected(string);
    callback settings_save_profile;
    callback settings_current_password_changed(string);
    callback settings_new_password_changed(string);
    callback settings_confirm_password_changed(string);
    callback settings_change_password;
    callback settings_log_out;
    callback settings_toggle_store_history;
    callback settings_toggle_hide_online;
    callback settings_toggle_friends_only_dms;
    callback settings_toggle_discoverable;
    callback settings_cycle_friend_request_privacy;
    callback settings_cycle_presence;
    callback settings_sign_out_others;
    callback settings_new_bot_name_changed(string);
    callback settings_create_bot;
    callback settings_refresh_bots;
    callback settings_copy_token(string);
    callback settings_dismiss_token;
    callback settings_regenerate_bot_token(string);
    callback settings_delete_bot(string);
    callback settings_bot_invite_username_changed(string);
    callback settings_invite_bot;
    callback settings_input_device_selected(string);
    callback settings_output_device_selected(string);
    callback settings_noise_gate_changed(float);
    callback settings_ui_scale_changed(float);
    callback settings_check_for_update;
    callback settings_restart_update;
    callback settings_measure_ping;

    if root.current-screen == Screen.Settings: SettingsScreen {
        width: size_ref.width;
        height: size_ref.height;
        category: root.settings_category;
        avatar_initial: root.settings_avatar_initial;
        avatar_color: root.settings_avatar_color;
        avatar_photo: root.settings_avatar_photo;
        has_photo: root.settings_has_photo;
        avatar_upload_busy: root.settings_avatar_upload_busy;
        display_name_input <=> root.settings_display_name_input;
        status_input <=> root.settings_status_input;
        bio_input <=> root.settings_bio_input;
        selected_avatar_index: root.settings_selected_avatar_index;
        profile_status: root.settings_profile_status;
        profile_status_is_error: root.settings_profile_status_is_error;
        current_password_input <=> root.settings_current_password_input;
        new_password_input <=> root.settings_new_password_input;
        confirm_password_input <=> root.settings_confirm_password_input;
        password_status: root.settings_password_status;
        password_status_is_error: root.settings_password_status_is_error;
        my_badge_text: root.settings_my_badge_text;
        my_badge_bg: root.settings_my_badge_bg;
        my_badge_fg: root.settings_my_badge_fg;
        store_chat_history: root.settings_store_chat_history;
        hide_online_status: root.settings_hide_online_status;
        friends_only_dms: root.settings_friends_only_dms;
        discoverable: root.settings_discoverable;
        friend_request_privacy_label: root.settings_friend_request_privacy_label;
        presence_status_label: root.settings_presence_status_label;
        is_staff: root.settings_is_staff;
        new_bot_name_input <=> root.settings_new_bot_name_input;
        bot_token_reveal: root.settings_bot_token_reveal;
        my_bots: root.settings_my_bots;
        bot_invite_username_input <=> root.settings_bot_invite_username_input;
        bot_status: root.settings_bot_status;
        bot_status_is_error: root.settings_bot_status_is_error;
        input_devices: root.settings_input_devices;
        output_devices: root.settings_output_devices;
        noise_gate: root.settings_noise_gate;
        noise_gate_label: root.settings_noise_gate_label;
        ui_scale: root.settings_ui_scale;
        version_line: root.settings_version_line;
        vault_hint: root.settings_vault_hint;
        update_check_status: root.settings_update_check_status;
        update_ready: root.settings_update_ready;
        ping_status: root.settings_ping_status;
        plus_active: root.settings_plus_active;
        plus_status_line: root.settings_plus_status_line;
        plus_busy_status: root.settings_plus_busy_status;
        plus_checkout_busy: root.settings_plus_checkout_busy;

        close => { root.settings_close(); }
        category_changed(cat) => { root.settings_category_changed(cat); }
        plus_subscribe => { root.settings_plus_subscribe(); }
        plus_manage_billing => { root.settings_plus_manage_billing(); }
        plus_refresh => { root.settings_plus_refresh(); }
        pick_avatar => { root.settings_pick_avatar(); }
        remove_avatar => { root.settings_remove_avatar(); }
        display_name_changed(t) => { root.settings_display_name_changed(t); }
        status_changed(t) => { root.settings_status_changed(t); }
        bio_changed(t) => { root.settings_bio_changed(t); }
        avatar_color_selected(c) => { root.settings_avatar_color_selected(c); }
        save_profile => { root.settings_save_profile(); }
        current_password_changed(t) => { root.settings_current_password_changed(t); }
        new_password_changed(t) => { root.settings_new_password_changed(t); }
        confirm_password_changed(t) => { root.settings_confirm_password_changed(t); }
        change_password => { root.settings_change_password(); }
        log_out => { root.settings_log_out(); }
        toggle_store_history => { root.settings_toggle_store_history(); }
        toggle_hide_online => { root.settings_toggle_hide_online(); }
        toggle_friends_only_dms => { root.settings_toggle_friends_only_dms(); }
        toggle_discoverable => { root.settings_toggle_discoverable(); }
        cycle_friend_request_privacy => { root.settings_cycle_friend_request_privacy(); }
        cycle_presence => { root.settings_cycle_presence(); }
        sign_out_others => { root.settings_sign_out_others(); }
        new_bot_name_changed(t) => { root.settings_new_bot_name_changed(t); }
        create_bot => { root.settings_create_bot(); }
        refresh_bots => { root.settings_refresh_bots(); }
        copy_token(t) => { root.settings_copy_token(t); }
        dismiss_token => { root.settings_dismiss_token(); }
        regenerate_bot_token(id) => { root.settings_regenerate_bot_token(id); }
        delete_bot(id) => { root.settings_delete_bot(id); }
        bot_invite_username_changed(t) => { root.settings_bot_invite_username_changed(t); }
        invite_bot => { root.settings_invite_bot(); }
        input_device_selected(d) => { root.settings_input_device_selected(d); }
        output_device_selected(d) => { root.settings_output_device_selected(d); }
        noise_gate_changed(v) => { root.settings_noise_gate_changed(v); }
        ui_scale_changed(v) => { root.settings_ui_scale_changed(v); }
        check_for_update => { root.settings_check_for_update(); }
        restart_update => { root.settings_restart_update(); }
        measure_ping => { root.settings_measure_ping(); }
    }

    // ==================== Server settings screen ====================
    in property <ServerSettingsCategory> ss_category: ServerSettingsCategory.Overview;
    in property <string> ss_server_name;
    in property <string> ss_server_initial;
    in property <image> ss_server_icon;
    in property <string> ss_header_meta;
    in property <bool> ss_is_owner: false;
    in property <bool> ss_is_platform_admin: false;
    in property <bool> ss_server_icon_busy: false;
    in-out property <string> ss_rename_server_input;
    in property <string> ss_server_status;
    in property <bool> ss_server_status_danger: false;
    in-out property <string> ss_custom_slug_input;
    in property <string> ss_custom_slug_display;
    in property <bool> ss_can_manage_channels: false;
    in-out property <string> ss_new_channel_name_input;
    in property <bool> ss_new_channel_is_voice: false;
    in property <[SSChannelRow]> ss_channels: [];
    in property <bool> ss_can_delete_channel: false;
    in-out property <string> ss_rename_channel_input;
    in property <string> ss_channel_perms_channel_id;
    in property <string> ss_channel_perms_channel_name;
    in property <[SSChannelRolePick]> ss_channel_perm_roles: [];
    in property <[SSChannelOverwritePermRow]> ss_channel_overwrite_perms: [];
    in property <bool> ss_can_manage_roles: false;
    in property <bool> ss_can_kick: false;
    in property <[SSMemberRow]> ss_members: [];
    in property <[SSRoleRow]> ss_roles: [];
    in-out property <string> ss_new_role_name_input;
    in property <string> ss_editing_role_id;
    in-out property <string> ss_role_name_edit_input;
    in property <string> ss_role_edit_color;
    in property <[SSPermRow]> ss_role_permissions: [];
    in property <bool> ss_editing_role_is_default: false;
    in property <bool> ss_confirm_delete_role: false;
    in property <string> ss_invite_code;
    in property <bool> ss_confirm_delete_server: false;

    callback ss_back;
    callback ss_category_changed(ServerSettingsCategory);
    callback ss_pick_icon;
    callback ss_remove_icon;
    callback ss_rename_server_input_changed(string);
    callback ss_rename_server;
    callback ss_custom_slug_changed(string);
    callback ss_save_custom_slug;
    callback ss_clear_custom_slug;
    callback ss_new_channel_name_changed(string);
    callback ss_toggle_new_channel_voice;
    callback ss_create_channel;
    callback ss_start_rename_channel(string, string);
    callback ss_rename_channel_input_changed(string);
    callback ss_save_rename_channel;
    callback ss_cancel_rename_channel;
    callback ss_delete_channel(string);
    callback ss_move_channel_up(string);
    callback ss_move_channel_down(string);
    callback ss_edit_channel_perms(string);
    callback ss_close_channel_perms;
    callback ss_select_channel_perm_role(string);
    callback ss_cycle_channel_overwrite_perm(int);
    callback ss_toggle_member_picker(string);
    callback ss_toggle_member_role(string, string);
    callback ss_kick_member(string);
    callback ss_open_profile(string);
    callback ss_new_role_name_changed(string);
    callback ss_create_role;
    callback ss_select_role_for_edit(string);
    callback ss_close_role_editor;
    callback ss_role_name_edit_changed(string);
    callback ss_save_role_name;
    callback ss_set_role_color(string, string);
    callback ss_toggle_role_permission(string, int);
    callback ss_confirm_delete_role_click(string);
    callback ss_cancel_delete_role;
    callback ss_delete_role(string);
    callback ss_copy_invite_code(string);
    callback ss_copy_invite_link(string);
    callback ss_regenerate_invite_code;
    callback ss_toggle_confirm_delete_server;
    callback ss_delete_server;

    if root.current-screen == Screen.ServerSettings: ServerSettingsScreen {
        width: size_ref.width;
        height: size_ref.height;
        category: root.ss_category;
        server_name: root.ss_server_name;
        server_initial: root.ss_server_initial;
        server_icon: root.ss_server_icon;
        header_meta: root.ss_header_meta;
        is_owner: root.ss_is_owner;
        is_platform_admin: root.ss_is_platform_admin;
        server_icon_busy: root.ss_server_icon_busy;
        rename_server_input <=> root.ss_rename_server_input;
        server_status: root.ss_server_status;
        server_status_danger: root.ss_server_status_danger;
        custom_slug_input <=> root.ss_custom_slug_input;
        custom_slug_display: root.ss_custom_slug_display;
        can_manage_channels: root.ss_can_manage_channels;
        new_channel_name_input <=> root.ss_new_channel_name_input;
