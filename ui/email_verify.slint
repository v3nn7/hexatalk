// Email verification gate -- shown instead of the chat UI whenever the
// signed-in account's email isn't verified yet, whether that's a brand new
// signup (code already sent, just needs the code) or a pre-existing account
// that predates email verification (needs to enter an email first).
// Rounded, elevated card centered on the dark backdrop with the HexaTalk
// brand mark and small-caps field labels.
import { Theme } from "theme.slint";
import { TextInputField, FieldLabel, PrimaryButton, LinkButton } from "widgets.slint";

export component EmailVerifyScreen inherits Rectangle {
    in-out property <string> email-input;
    in-out property <string> code-input;
    in property <bool> code-sent: false;
    in property <string> verify-error;
    in property <bool> verify-busy;

    callback email-edited(string);
    callback send-code;
    callback code-edited(string);
    callback verify-code;
    callback change-email;
    callback log-out;

    background: Theme.bg-primary;

    HorizontalLayout {
        alignment: center;
        VerticalLayout {
        alignment: center;

        card := Rectangle {
            width: 380px;
            background: Theme.bg-secondary;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 8px;
            drop-shadow-offset-x: Theme.shadow-offset;
            drop-shadow-offset-y: Theme.shadow-offset;
            drop-shadow-color: Theme.shadow-color;
            clip: true;

            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: 2px;
                background: Theme.accent;
            }

            VerticalLayout {
                padding: 32px;
                spacing: 12px;
                alignment: start;

                // Brand mark, centered like the Discord auth modal logo.
                HorizontalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../assets/textures/hexatalkicon.png");
                        width: 40px;
                        height: 40px;
                        image-fit: ImageFit.contain;
                    }
                }

                Text {
                    text: "Verify your email";
                    font-size: 20px;
                    font-family: Theme.font-medium;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.code-sent
                        ? "Enter the 6-digit code we sent to " + root.email-input + "."
                        : "HexaTalk now requires a verified email. Enter yours below to get a code.";
                    font-size: 13px;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }

                if !root.code-sent: FieldLabel { text: "EMAIL"; }
                if !root.code-sent: TextInputField {
                    placeholder: "you@example.com";
                    value <=> root.email-input;
                    enabled: !root.verify-busy;
                    edited(text) => { root.email-edited(text); }
                    submitted => { root.send-code(); }
                }

                if root.code-sent: FieldLabel { text: "VERIFICATION CODE"; }
                if root.code-sent: TextInputField {
                    placeholder: "123456";
                    is-number: true;
                    value <=> root.code-input;
                    enabled: !root.verify-busy;
                    edited(text) => { root.code-edited(text); }
                    submitted => { root.verify-code(); }
                }

                if root.verify-error != "": Rectangle {
                    background: Theme.danger-soft;
                    border-width: 1px;
                    border-color: Theme.danger-dim;
                    border-radius: Theme.radius-md;
                    height: error-text.preferred-height + 24px;
                    // Danger bar on the alert's left edge.
                    Rectangle {
                        x: 0;
                        y: 0;
                        width: 3px;
                        height: parent.height;
                        border-radius: 2px;
                        background: Theme.danger;
                    }
                    error-text := Text {
                        x: 14px;
                        width: parent.width - 26px;
                        y: 12px;
                        text: root.verify-error;
                        font-size: 13px;
                        color: Theme.danger;
                        wrap: word-wrap;
                    }
                }

                Rectangle { height: 6px; }
                if !root.code-sent: PrimaryButton {
                    text: root.verify-busy ? "Sending…" : "Send code";
                    enabled: !root.verify-busy;
                    busy: root.verify-busy;
                    clicked => { root.send-code(); }
                }
                if root.code-sent: PrimaryButton {
                    text: root.verify-busy ? "Verifying…" : "Verify";
                    enabled: !root.verify-busy && root.code-input != "";
                    busy: root.verify-busy;
                    clicked => { root.verify-code(); }
                }

                if root.code-sent: HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    Text {
                        text: "Wrong address, or no code arrived?";
                        font-size: 12px;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }
                    LinkButton {
                        text: "Change email";
                        clicked => { root.change-email(); }
                    }
                }

                Rectangle { height: 4px; }
                HorizontalLayout {
                    alignment: center;
                    LinkButton {
                        text: "Log out";
                        clicked => { root.log-out(); }
                    }
                }
            }
        }
        }
    }
}
