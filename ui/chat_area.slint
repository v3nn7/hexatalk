// Header + message history + composer -- the right-hand chat pane. Port of
// the `Some(_)` / `None` branches of `chat_panel` in src/view/chat.rs.
// "Violet Night" pass: 48px channel bar (# name, topic, pinned/member
// vector icons), grouped message history, and a rounded composer pill with
// attach / emoji / send buttons inside.
import { ListView, Slider } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Avatar, SecondaryButton, PinIcon, MembersIcon, SmileyIcon, SpeakerIcon } from "widgets.slint";
import { ChatMessageRow, VoiceUserVolumeRow } from "chat_types.slint";
import { MessageRow } from "message_row.slint";

component HeaderChip inherits Rectangle {
    in property <string> text;
    in property <bool> warn: false;
    height: 22px;
    width: label.preferred-width + 20px;
    border-radius: 11px;
    background: root.warn ? Theme.warning-soft : Theme.accent-soft;
    border-width: 1px;
    border-color: root.warn ? Theme.warning-border : Theme.border-strong;
    label := Text {
        text: root.text;
        font-size: 11px;
        font-family: Theme.font-medium;
        color: root.warn ? Theme.warning : Theme.accent-hover;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component HeaderButton inherits Rectangle {
    in property <string> text;
    in property <bool> accent: false;
    callback clicked;
    height: 30px;
    width: label.preferred-width + 20px;
    border-radius: Theme.radius-sm;
    background: root.accent
        ? (touch.pressed ? Theme.accent-pressed : (touch.has-hover ? Theme.accent : Theme.accent-dim))
        : (touch.pressed ? Theme.bg-tertiary : (touch.has-hover ? Theme.bg-hover : Theme.bg-secondary));
    border-width: 1px;
    border-color: root.accent ? Theme.accent : (touch.has-hover ? Theme.border-strong : Theme.border);
    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
    label := Text {
        text: root.text;
        font-size: Theme.text-sm;
        color: root.accent ? Theme.text-on-accent : Theme.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Small square icon button for the channel bar (pinned messages, member
// list): quiet muted vector glyph that lights up on hover. The glyph is
// passed as a child (PinIcon / MembersIcon) and recolors itself from `hot`.
component HeaderIcon inherits Rectangle {
    out property <bool> hot: touch.has-hover;
    callback clicked;
    width: 30px;
    height: 30px;
    border-radius: Theme.radius-sm;
    background: touch.has-hover ? Theme.bg-hover : transparent;
    animate background { duration: 120ms; }
    HorizontalLayout {
        alignment: center;
        VerticalLayout {
            alignment: center;
            @children
        }
    }
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

export component ChatArea inherits Rectangle {
    in property <bool> has_conversation: false;
    // True between opening a conversation and the first history payload --
    // the message list shows "Loading…" instead of a misleading empty pane.
    in property <bool> loading: false;

    in property <string> peer_title;
    in property <string> peer_initial;
    in property <color> peer_avatar_color: Theme.accent;
    in property <image> peer_photo;
    in property <bool> peer_online: false;
    in property <bool> is_channel_icon: false;
    // Voice channel header gets a speaker glyph instead of "#".
    in property <bool> is_voice_icon: false;

    in property <bool> is_direct: false;
    in property <bool> peer_connected: false;
    in property <string> connection_label;
    in property <string> sas_label;
    in property <bool> show_call_button: false;
    in property <bool> is_server_channel: false;
    in property <bool> channel_muted: false;
    in property <bool> store_enabled: true;
    in property <bool> store_allowed: true;
    in property <bool> clear_chat_busy: false;
    in property <bool> clear_chat_confirm: false;
    in property <bool> can_voice: false;
    in property <bool> in_voice: false;
    in property <string> room_voice_status;
    in property <string> voice_users_label;
    in property <[VoiceUserVolumeRow]> voice_users: [];

    // Optional Discord-style channel-bar extras. Empty = hidden, so existing
    // callers that never set them keep the old look.
    in property <string> channel_topic;
    in property <string> member_count_label;

    in property <[ChatMessageRow]> messages: [];
    in property <[string]> quick_emojis: [];

    // Scroll-to-bottom pulse, driven from Rust (CHAT_SCROLL_PULSE in
    // src/main.rs): every increment jumps the message list to the end. Rust
    // only pulses when it makes sense (own send, open conversation, new
    // incoming message), so no near-bottom detection happens here.
    // The Timer that applies the scroll lives next to `list` inside the
    // conversation branch (Slint cannot reach ids across `if` scopes).
    in property <int> scroll_pulse: 0;

    in property <bool> is_editing: false;
    in property <string> input_placeholder;
    in property <string> send_label;
    in property <bool> crypto_ready: true;
    in-out property <string> message_input;
    // Discord-style @ autocomplete: names matching the "@prefix" token the
    // user is currently typing (filled from Rust; includes "everyone" where
    // the conversation supports it). Empty = popup hidden.
    in property <[string]> mention_suggestions: [];
    // Keyboard-selected row of the mention popup (ArrowUp/ArrowDown in the
    // composer move it, Enter picks it). Resets whenever the suggestion
    // list changes.
    property <int> mention_active: 0;
    changed mention_suggestions => { root.mention_active = 0; }
    in property <bool> has_pending_attachment: false;
    in property <image> pending_attachment_preview;
    in property <bool> has_pending_reply: false;
    in property <string> pending_reply_line;
    in property <string> typing_line;
    in property <string> chat_error;
    in property <string> warning_line;

    callback start_call;
    callback toggle_store;
    callback toggle_channel_mute;
    callback toggle_clear_confirm;
    callback confirm_clear;
    callback join_voice;
    callback leave_voice;
    // New channel-bar icon actions (wired up on the Rust side later; safe to
    // leave unconnected -- the icons simply do nothing).
    callback toggle_pins;
    callback toggle_member_list;

    callback message_input_edited(string);
    callback mention_pick(string);
    callback send;
    callback pick_attachment;
    callback remove_attachment;
    callback cancel_edit;
    callback cancel_reply;

    callback react(string, string);
    callback reply(string, string, string);
    callback copy(string);
    callback edit(string, string, bool);
    callback delete(string);
    callback purge(string);
    callback open_attachment(string);
    callback report(string);
    callback report_reason(string, string, string);
    callback report_cancel(string);
    callback voice_volume_changed(string, float);

    background: Theme.bg-primary;

    // Debounce for the per-peer voice volume sliders: dragging fires
    // `changed` per tick, and every tick used to persist settings to disk
    // (Message::VoiceVolumeChanged -> persist_settings). The slider still
    // moves live; Rust hears about it 400ms after the drag stops.
    // Nested Slider callbacks cannot call Timer.restart() safely (codegen
    // binds the timer id to the wrong self), so bump this kick counter and
    // re-arm the timer from the component root.
    property <string> pending_vol_user;
    property <float> pending_vol_value;
    property <int> voice_vol_kick: 0;
    changed voice_vol_kick => {
        voice_vol_timer.running = false;
        voice_vol_timer.running = true;
    }
    voice_vol_timer := Timer {
        interval: 400ms;
        triggered => {
            self.running = false;
            root.voice_volume_changed(root.pending_vol_user, root.pending_vol_value);
        }
    }

    // Welcome/empty state. Deliberately NOT a fill-parent VerticalLayout
    // with `alignment: center`: a layout that fills its parent propagates
    // its size constraints upward, and this content's bounded maximum
    // height (~sum of the fixed-size children) was clamping the entire
    // window's scene -- every screen rendered at ~390px tall with the rest
    // of the OS window black. An absolutely-positioned (explicit x/y/size)
    // layout contributes no constraints to the parent, so the Rectangle
    // stays unconstrained and simply centers the content box.
    if !root.has_conversation: Rectangle {
        opacity: 0;
        init => { self.opacity = 1; }
        animate opacity { duration: 140ms; }
        welcome_content := VerticalLayout {
            x: (parent.width - self.preferred-width) / 2;
            y: (parent.height - self.preferred-height) / 2;
            width: self.preferred-width;
            height: self.preferred-height;
            spacing: 10px;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    property <float> breathe: 0.5 + 0.5 * Math.sin(animation-tick() / 2600ms * 360deg);
                    width: 76px;
                    height: 76px;
                    background: Theme.accent;
                    border-width: 1px;
                    border-color: Theme.accent-hover;
                    border-radius: Theme.radius-lg + 4px;
                    drop-shadow-offset-x: 0px;
                    drop-shadow-offset-y: 2px;
                    drop-shadow-blur: 14px + self.breathe * 10px;
                    drop-shadow-color: Theme.accent-soft-strong;
                    animate drop-shadow-blur { duration: 200ms; }
                    Text {
                        text: ">_";
                        font-size: 28px;
                        font-family: Theme.font-medium;
                        color: Theme.text-on-accent;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            Text {
                text: "Welcome to HexaTalk";
                font-size: 30px;
                font-family: Theme.font-medium;
                color: Theme.text-bright;
                horizontal-alignment: center;
            }
            Text {
                text: "Pick a chat on the left, or add a friend to get started.";
                font-size: Theme.text-md;
                color: Theme.text-muted;
                horizontal-alignment: center;
            }
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    background: Theme.bg-secondary;
                    border-width: 1px;
                    border-color: Theme.border;
                    height: 32px;
                    width: hint.preferred-width + 28px;
                    hint := Text {
                        text: "[DM] chats · [Fr] friends · [+] servers";
                        font-size: Theme.text-sm;
                        font-family: Theme.font-medium;
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    if root.has_conversation: VerticalLayout {
        opacity: 0;
        init => { self.opacity = 1; }
        animate opacity { duration: 140ms; }
        // ---- Header (channel bar) ----
        Rectangle {
            height: 48px;
            background: Theme.bg-secondary;
            border-width: 1px;
            border-color: Theme.border;
            // Delikatny cień pod paskiem kanału — głębia zamiast płaskiego szwu.
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: 2px;
            drop-shadow-blur: 6px;
            drop-shadow-color: #00000033;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 12px;
                // Vertical padding sized so the 30px HeaderButtons fill the
                // cross axis exactly (48 - 9 - 9 = 30) under the default
                // stretch alignment.
                padding-top: 9px;
                padding-bottom: 9px;
                spacing: 10px;
                // No `alignment: start` -- same story as the composer row
                // and the rail (see their comments): it disabled the
                // trailing spacer's `horizontal-stretch: 1` below, so the
                // Call/Store/Clear buttons weren't actually pinned to the
                // right edge -- their position was just whatever came after
                // the preceding elements' own widths. Since `connection_label`
                // changes text (and therefore width) throughout a peerseal
                // handshake, the buttons visibly shifted under the mouse
                // every time it updated, flickering hover state.
                if !root.is_channel_icon && !root.is_voice_icon: Avatar {
                    initial: root.peer_initial;
                    avatar-color: root.peer_avatar_color;
                    photo-source: root.peer_photo;
                    show-presence: true;
                    online: root.peer_online;
                    vertical-stretch: 0;
                }
                if root.is_channel_icon: Text {
                    text: "#";
                    font-size: 18px;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
                if root.is_voice_icon: SpeakerIcon {
                    fg: Theme.text-muted;
                    vertical-stretch: 0;
                }
                Text {
                    text: root.peer_title;
                    font-size: Theme.text-lg;
                    font-family: Theme.font-medium;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                }
                // Channel topic, Discord-style: "│ topic" right of the name.
                if root.channel_topic != "": Text {
                    text: "│";
                    font-size: Theme.text-md;
                    color: Theme.border-strong;
                    vertical-alignment: center;
                }
                if root.channel_topic != "": Text {
                    text: root.channel_topic;
                    font-size: Theme.text-sm;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                    overflow: elide;
                    width: min(self.preferred-width, 240px);
                }
                if root.is_direct: HeaderChip { text: root.connection_label; warn: !root.peer_connected; }
                if root.is_direct && root.sas_label != "": Text {
                    text: "SAS " + root.sas_label;
                    font-size: 11px;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                if root.show_call_button: HeaderButton { text: "Call"; accent: true; clicked => { root.start_call(); } }
                if root.is_server_channel: HeaderButton {
                    text: root.channel_muted ? "Unmute" : "Mute";
                    accent: root.channel_muted;
                    clicked => { root.toggle_channel_mute(); }
                }
                if !root.is_server_channel: HeaderButton {
                    text: root.store_enabled ? "Store: ON" : "Store: OFF";
                    accent: root.store_enabled;
                    clicked => { root.toggle_store(); }
                }
                if !root.is_server_channel && !root.store_allowed: Text {
                    text: "ephemeral";
                    font-size: Theme.text-xs;
                    color: Theme.warning;
                    vertical-alignment: center;
                }
                if !root.is_server_channel && root.clear_chat_busy: Text {
                    text: "Clearing…";
                    font-size: Theme.text-sm;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
                if !root.is_server_channel && !root.clear_chat_busy && root.clear_chat_confirm: Text {
                    text: "Wipe?";
                    font-size: 11px;
                    color: Theme.warning;
                    vertical-alignment: center;
                }
                if !root.is_server_channel && !root.clear_chat_busy && root.clear_chat_confirm: HeaderButton {
                    text: "Yes"; clicked => { root.confirm_clear(); }
                }
                if !root.is_server_channel && !root.clear_chat_busy && root.clear_chat_confirm: HeaderButton {
                    text: "No"; clicked => { root.toggle_clear_confirm(); }
                }
                if !root.is_server_channel && !root.clear_chat_busy && !root.clear_chat_confirm: HeaderButton {
                    text: "Clear"; clicked => { root.toggle_clear_confirm(); }
                }
                if root.can_voice: HeaderButton {
                    text: root.in_voice ? "Leave voice" : "Join voice";
                    accent: true;
                    clicked => { root.in_voice ? root.leave_voice() : root.join_voice(); }
                }
                if root.can_voice && root.room_voice_status != "": Text {
                    text: root.room_voice_status;
                    font-size: 11px;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
                if root.can_voice && root.in_voice && root.voice_users_label != "": Text {
                    text: "· " + root.voice_users_label;
                    font-size: 11px;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
                // Channel-bar icons, far right (pinned messages, member list).
                pins_btn := HeaderIcon {
                    clicked => { root.toggle_pins(); }
                    PinIcon {
                        fg: pins_btn.hot ? Theme.text-primary : Theme.text-muted;
                    }
                }
                members_btn := HeaderIcon {
                    clicked => { root.toggle_member_list(); }
                    MembersIcon {
                        fg: members_btn.hot ? Theme.text-primary : Theme.text-muted;
                    }
                }
                if root.member_count_label != "": Text {
                    text: root.member_count_label;
                    font-size: Theme.text-xs;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
            }
        }

        // ---- Voice volume panel (per-peer gain sliders while in a room) ----
        if root.in_voice && root.voice_users.length > 0: Rectangle {
            background: Theme.bg-secondary;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 10px;
                spacing: 6px;
                Text {
                    text: "VOICE VOLUME";
                    font-size: Theme.text-xs;
                    font-family: Theme.font-medium;
                    color: Theme.text-muted;
                }
                for u in root.voice_users: HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: u.name;
                        font-size: 12px;
                        color: Theme.text-primary;
                        width: 140px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Slider {
                        horizontal-stretch: 1;
                        minimum: 0;
                        maximum: 5;
                        value: u.volume;
                        changed(v) => {
                            root.pending_vol_user = u.user_id;
                            root.pending_vol_value = v;
                            root.voice_vol_kick += 1;
                        }
                    }
                    Text {
                        text: Math.round(u.volume * 100) + "%";
                        font-size: 11px;
                        color: Theme.text-muted;
                        width: 40px;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // ---- Message list ----
        Rectangle {
            vertical-stretch: 1;
            background: Theme.bg-primary;
            // Mirror root.scroll_pulse so `changed` can fire next to `list`
            // (Slint cannot reach ids declared inside this `if` from outside).
            property <int> pulse: root.scroll_pulse;
            changed pulse => {
                if (self.pulse > 0) {
                    scroll_timer.running = true;
                }
            }
            // Deferred one tick past the model/layout update: right after
            // `messages` changes, `viewport-height` still reflects the old
            // rows, so scrolling immediately would land short of the real end.
            scroll_timer := Timer {
                interval: 80ms;
                triggered => {
                    self.running = false;
                    list.viewport-y = min(0px, list.visible-height - list.viewport-height);
                }
            }
            list := ListView {
                for m in root.messages: MessageRow {
                    msg: m;
                    quick_emojis: root.quick_emojis;
                    react(id, emoji) => { root.react(id, emoji); }
                    reply(id, author, snippet) => { root.reply(id, author, snippet); }
                    copy(text) => { root.copy(text); }
                    edit(id, body, enc) => { root.edit(id, body, enc); }
                    delete(id) => { root.delete(id); }
                    purge(id) => { root.purge(id); }
                    open_attachment(url) => { root.open_attachment(url); }
                    report(id) => { root.report(id); }
                    report_reason(id, body, reason) => { root.report_reason(id, body, reason); }
                    report_cancel(id) => { root.report_cancel(id); }
                }
            }
            // History fetch in flight (set on conversation open, cleared on
            // the first MessagesUpdated) -- show a quiet indicator instead
            // of a blank pane. Absolutely positioned like the welcome
            // screen: a fill-parent centered layout would propagate bounded
            // size constraints upward and clamp the window scene.
            if root.loading && root.messages.length == 0: VerticalLayout {
                x: (parent.width - self.preferred-width) / 2;
                y: (parent.height - self.preferred-height) / 2;
                width: self.preferred-width;
                height: self.preferred-height;
                spacing: 6px;
                Text {
                    text: "Loading…";
                    font-size: Theme.text-md;
                    font-family: Theme.font-medium;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                    opacity: 0.65 + 0.35 * Math.sin((animation-tick() / 420ms) * 1deg);
                }
            }
            // Loaded, genuinely empty conversation -- friendly empty state
            // instead of a bare one-liner.
            if !root.loading && root.messages.length == 0: VerticalLayout {
                x: (parent.width - self.preferred-width) / 2;
                y: (parent.height - self.preferred-height) / 2;
                width: self.preferred-width;
                height: self.preferred-height;
                spacing: 6px;
                Text {
                    text: "💬";
                    font-size: 26px;
                    horizontal-alignment: center;
                }
                Text {
                    text: "No messages yet";
                    font-size: Theme.text-md;
                    font-family: Theme.font-medium;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Say hi and break the ice.";
                    font-size: Theme.text-sm;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                }
            }
        }

        // ---- Composer ----
        Rectangle {
            background: Theme.bg-secondary;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 14px;
                spacing: 8px;

                if root.typing_line != "": HorizontalLayout {
                    spacing: 6px;
                    // Animated 3-dot typing indicator, Discord-style.
                    Rectangle {
                        width: 26px;
                        height: 14px;
                        vertical-stretch: 0;
                        for i in 3: Rectangle {
                            property <float> phase: Math.mod(animation-tick() / 1ms, 1200) / 1200;
                            x: 2px + i * 8px;
                            y: (parent.height - self.height) / 2 - (Math.sin((self.phase * 360deg) - (i * 40deg)) > 0.35 ? 2.5px : 0px);
                            width: 5px;
                            height: 5px;
                            border-radius: 2.5px;
                            background: Theme.accent;
                            opacity: Math.sin((self.phase * 360deg) - (i * 40deg)) > 0.35 ? 1 : 0.35;
                        }
                    }
                    Text {
                        text: root.typing_line;
                        font-size: 11px;
                        font-family: Theme.font-medium;
                        color: Theme.accent;
                        vertical-alignment: center;
                    }
                }

                if root.is_editing: Text {
                    text: "▌ editing message";
                    font-size: 11px;
                    font-family: Theme.font-medium;
                    color: Theme.warning;
                }

                if root.has_pending_reply: Rectangle {
                    background: Theme.bg-tertiary;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: Theme.radius-md;
                    height: 36px;
                    Rectangle {
                        x: 0;
                        y: 0;
                        width: 2px;
                        height: parent.height;
                        background: Theme.accent-dim;
                    }
                    HorizontalLayout {
                        padding: 10px;
                        spacing: 10px;
                        Text {
                            text: root.pending_reply_line;
                            font-size: Theme.text-sm;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        HeaderButton { text: "Cancel"; clicked => { root.cancel_reply(); } }
                    }
                }

                if root.has_pending_attachment: Rectangle {
                    background: Theme.bg-tertiary;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: Theme.radius-md;
                    height: 60px;
                    HorizontalLayout {
                        padding: 8px;
                        spacing: 12px;
                        Rectangle {
                            width: 44px;
                            background: Theme.bg-secondary;
                            border-width: 1px;
                            border-color: Theme.border;
                            border-radius: Theme.radius-sm;
                            Image { source: root.pending_attachment_preview; width: 44px; height: 44px; image-fit: ImageFit.cover; }
                        }
                        Text {
                            text: "Image attached";
                            font-size: Theme.text-sm;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        HeaderButton { text: "Remove"; clicked => { root.remove_attachment(); } }
                    }
                }

                if root.chat_error != "": Rectangle {
                    background: Theme.danger-soft;
                    border-width: 1px;
                    border-color: Theme.danger-dim;
                    border-radius: Theme.radius-md;
                    height: 36px;
                    // Danger spine on the left edge, matching the auth /
                    // email-verify alert style.
                    Rectangle {
                        x: 0;
                        y: 0;
                        width: 3px;
                        height: parent.height;
                        border-radius: 2px;
                        background: Theme.danger;
                    }
                    Text {
                        x: 14px;
                        width: parent.width - 26px;
                        text: "⚠  " + root.chat_error;
                        font-size: Theme.text-sm;
                        color: Theme.danger;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                if root.chat_error == "" && root.warning_line != "": Rectangle {
                    background: Theme.warning-soft;
                    border-width: 1px;
                    border-color: Theme.warning-border;
                    border-radius: Theme.radius-md;
                    height: 36px;
                    Rectangle {
                        x: 0;
                        y: 0;
                        width: 3px;
                        height: parent.height;
                        border-radius: 2px;
                        background: Theme.warning;
                    }
                    Text {
                        x: 14px;
                        width: parent.width - 26px;
                        text: root.warning_line;
                        font-size: Theme.text-sm;
                        color: Theme.warning;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                // ---- @ mention autocomplete popup ----
                // In-flow strip directly above the input row (grows the
                // composer while open, so it can never cover messages).
                if root.mention_suggestions.length > 0: Rectangle {
                    background: Theme.bg-tertiary;
                    border-width: 1px;
                    border-color: Theme.border-strong;
                    border-radius: 6px;
                    VerticalLayout {
                        padding: 4px;
                        spacing: 2px;
                        for name[i] in root.mention_suggestions: Rectangle {
                            height: 26px;
                            border-radius: 4px;
                            background: i == root.mention_active ? Theme.bg-hover
                                : (mention_touch.has-hover ? Theme.bg-hover : transparent);
                            HorizontalLayout {
                                padding-left: 8px;
                                spacing: 6px;
                                Text {
                                    text: "@" + name;
                                    font-size: Theme.text-sm;
                                    font-family: Theme.font-medium;
                                    color: name == "everyone" ? Theme.warning : Theme.accent;
                                    vertical-alignment: center;
                                }
                            }
                            mention_touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.mention_pick(name); } }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    // No `alignment` here (default `stretch`). The composer
                    // pill below is the only flexible item (horizontal
                    // stretch: 1) and its own TextInput child derives its
                    // width from the pill's final width -- i.e. the pill's
                    // width must come from the layout handing it real
                    // leftover space. `alignment: center` (like the same
                    // anti-pattern fixed in message_row.slint) disables
                    // stretch-based sizing entirely, so the pill fell back
                    // to its own preferred width, which is itself derived
                    // from its children's `parent.width`-relative bindings
                    // -- a genuine circular size dependency that overflowed
                    // the stack on *every* chat screen (this composer
                    // renders regardless of message count, unlike the
                    // message list).

                    // Rounded composer pill:
                    // [+] attach · text input · smiley · [send]
                    composer_box := Rectangle {
                        horizontal-stretch: 1;
                        height: 44px;
                        border-radius: Theme.radius-lg;
                        background: composer_input.has-focus ? Theme.bg-elevated : Theme.bg-tertiary;
                        border-width: 1px;
                        border-color: composer_input.has-focus ? Theme.accent : Theme.border;
                        // Focus glow jak w TextInputField + lekki cień pill'a.
                        drop-shadow-offset-x: 0px;
                        drop-shadow-offset-y: 0px;
                        drop-shadow-blur: composer_input.has-focus ? 10px : 0px;
                        drop-shadow-color: Theme.accent-soft-strong;
                        animate background { duration: 120ms; }
                        animate border-color { duration: 120ms; }
                        animate drop-shadow-blur { duration: 160ms; easing: ease-out; }

                        // Circular attach button on the left edge.
                        if !root.is_editing && root.crypto_ready: Rectangle {
                            x: 8px;
                            y: (parent.height - 30px) / 2;
                            width: 30px;
                            height: 30px;
                            border-radius: 15px;
                            background: att_touch.has-hover ? Theme.bg-hover : Theme.bg-secondary;
                            border-width: 1px;
                            border-color: att_touch.has-hover ? Theme.border-strong : Theme.border;
                            animate background { duration: 120ms; }
                            animate border-color { duration: 120ms; }
                            Text {
                                text: "+";
                                font-size: 16px;
                                color: att_touch.has-hover ? Theme.text-primary : Theme.text-muted;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            att_touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.pick_attachment(); } }
                        }

                        composer_input := TextInput {
                            x: (!root.is_editing && root.crypto_ready) ? 46px : 14px;
                            // Right edge stops short of the emoji + send
                            // buttons; the chain input -> emoji -> send is
                            // one-directional, so there is no size cycle.
                            width: emoji_btn.x - self.x - 8px;
                            height: parent.height;
                            vertical-alignment: center;
                            text <=> root.message_input;
                            color: Theme.text-primary;
                            font-size: Theme.text-md;
                            edited => { root.message_input_edited(self.text); }
                            // While the mention popup is open, Enter completes
                            // the active suggestion instead of sending.
                            accepted => {
                                if (root.mention_suggestions.length > 0) {
                                    root.mention_pick(root.mention_suggestions[min(root.mention_active, root.mention_suggestions.length - 1)]);
                                } else if (root.crypto_ready) {
                                    root.send();
                                }
                            }
                            // Arrow keys navigate the mention popup while
                            // it's open; everything else falls through to
                            // normal text editing.
                            key-pressed(event) => {
                                if (root.mention_suggestions.length > 0) {
                                    if (event.text == Key.DownArrow) {
                                        root.mention_active = min(root.mention_active + 1, root.mention_suggestions.length - 1);
                                        return accept;
                                    }
                                    if (event.text == Key.UpArrow) {
                                        root.mention_active = max(root.mention_active - 1, 0);
                                        return accept;
                                    }
                                }
                                reject
                            }
                        }
                        if root.message_input == "": Text {
                            x: composer_input.x;
                            text: root.input_placeholder;
                            color: Theme.text-muted;
                            font-size: Theme.text-md;
                            vertical-alignment: center;
                            height: parent.height;
                        }

                        // Emoji button: appends the first quick emoji to the
                        // draft. The glyph is a vector smiley, not an emoji,
                        // so it follows the theme like every other icon.
                        emoji_btn := Rectangle {
                            x: send_btn.x - 36px;
                            y: (parent.height - 30px) / 2;
                            width: 30px;
                            height: 30px;
                            border-radius: 15px;
                            background: emoji_touch.has-hover ? Theme.bg-hover : transparent;
                            animate background { duration: 120ms; }
                            SmileyIcon {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                fg: emoji_touch.has-hover ? Theme.text-primary : Theme.text-muted;
                            }
                            emoji_touch := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => {
                                    root.message_input = root.message_input
                                        + (root.quick_emojis.length > 0 ? root.quick_emojis[0] : "😊");
                                }
                            }
                        }

                        // Send button, tucked into the pill's right edge.
                        // Empty sends are a no-op in Rust (body trimmed,
                        // attachment-only allowed) -- reflect that in the UI.
                        send_btn := Rectangle {
                            property <bool> can_send: root.crypto_ready && (root.message_input != "" || root.has_pending_attachment);
                            x: parent.width - self.width - 7px;
                            y: (parent.height - 30px) / 2;
                            width: send_text.preferred-width + 18px;
                            height: 30px;
                            border-radius: 6px;
                            background: !self.can_send ? Theme.bg-secondary
                                : (send_touch.pressed ? Theme.accent-pressed
                                : (send_touch.has-hover ? Theme.accent : Theme.accent-dim));
                            border-width: 1px;
                            border-color: self.can_send ? Theme.accent : Theme.border;
                            animate background { duration: 120ms; }
                            animate border-color { duration: 120ms; }
                            send_text := Text {
                                text: root.send_label;
                                font-size: Theme.text-sm;
                                font-family: Theme.font-medium;
                                color: send_btn.can_send ? Theme.text-on-accent : Theme.text-muted;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            send_touch := TouchArea {
                                enabled: send_btn.can_send;
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { root.send(); }
                            }
                        }
                    }

                    if root.is_editing: SecondaryButton { text: "Cancel"; width: 80px; clicked => { root.cancel_edit(); } }
                }
            }
        }
    }
}
