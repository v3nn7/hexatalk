// View-model structs for the per-server Settings screen -- mirrors
// src/view/server_settings.rs.

export struct SSChannelRow {
    conversation_id: string,
    name: string,
    is_voice: bool,
    is_renaming: bool,
    is_editing_perms: bool,
    is_system: bool,
    is_announcement: bool,
    can_move_up: bool,
    can_move_down: bool,
}

/// Per-role row when editing channel overwrites.
export struct SSChannelRolePick {
    role_id: string,
    name: string,
    selected: bool,
    has_overwrite: bool,
}

/// One permission bit for the selected role on a channel.
/// mode: 0=inherit, 1=allow, 2=deny
export struct SSChannelOverwritePermRow {
    bit: int,
    label: string,
    mode: int,
}

export struct SSAssignableRole {
    role_id: string,
    name: string,
    assigned: bool,
}

export struct SSMemberRow {
    user_id: string,
    display_name: string,
    username: string,
    initial: string,
    avatar_color: color,
    photo: image,
    photo_url: string,
    is_owner: bool,
    role_label: string,
    picker_open: bool,
    assignable_roles: [SSAssignableRole],
}

export struct SSRoleRow {
    role_id: string,
    name: string,
    color: color,
    is_editing: bool,
}

export struct SSPermRow {
    bit: int,
    label: string,
    enabled: bool,
}
