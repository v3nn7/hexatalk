// Right-hand server members drawer -- port of `view_members_drawer` /
// `member_row_ui` in src/view/chat.rs. Small-caps group headers, avatar +
// presence rows with a hover wash, role-tinted nicks, a solid BOT tag,
// offline members dimmed until hovered.
import { Theme } from "theme.slint";
import { Avatar, ResizeHandle, BotTag } from "widgets.slint";
import { MemberRow } from "chat_types.slint";

// One hoisted role group ("ADMINISTRATOR — 3"-style). When the integrator
// feeds `MembersDrawer.role_groups` the drawer renders these groups instead
// of the plain ONLINE / OFFLINE / BOTS split -- pure addition, current
// callers that leave it empty see no behavior change.
export struct MemberGroupRow {
    title: string,
    color: color,
    members: [MemberRow],
}

// Small-caps group header (ONLINE / OFFLINE / BOTS / role names), aligned
// with the row content below it like Discord's member list section labels.
component MemberSectionHeader inherits Rectangle {
    in property <string> text;
    in property <color> label-color: Theme.text-muted;
    height: 28px;
    Text {
        x: Theme.space-3;
        text: root.text;
        font-size: Theme.text-xs;
        font-family: Theme.font-medium;
        letter-spacing: 1px;
        color: root.label-color;
        vertical-alignment: center;
    }
}

// Single member row: avatar with presence dot, role-tinted name (+ BOT tag /
// badge chip) and role chips underneath; hover wash over the whole row,
// offline rows dimmed until hovered (Discord behavior).
component MemberEntry inherits Rectangle {
    in property <MemberRow> m;
    callback open_profile(string);

    // Highest role tints the nick like Discord; fall back to theme text
    // when the member has no roles or the role color is transparent.
    property <color> nick-color: m.roles.length > 0 && m.roles[0].color.alpha > 0 ? m.roles[0].color : Theme.text-primary;

    height: content.preferred-height + Theme.space-2;
    background: touch.has-hover ? Theme.bg-hover : transparent;
    animate background { duration: 120ms; }
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.open_profile(m.user_id); }
    }
    content := HorizontalLayout {
        // Offline members are dimmed like Discord (whole row, not just the
        // avatar); hovering restores legibility. Online rows stay opaque.
        opacity: m.online ? 1.0 : (touch.has-hover ? 0.9 : 0.45);
        animate opacity { duration: 120ms; }
        padding-left: Theme.space-3;
        padding-right: Theme.space-2;
        padding-top: Theme.space-1;
        padding-bottom: Theme.space-1;
        spacing: Theme.space-2;
        alignment: start;
        Avatar {
            size: 32px;
            initial: m.initial;
            avatar-color: m.avatar_color;
            photo-source: m.photo;
            show-presence: true;
            online: m.online;
            vertical-stretch: 0;
        }
        VerticalLayout {
            spacing: 2px;
            alignment: center;
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Text { text: m.display_name; font-size: Theme.text-sm; font-family: Theme.font-medium; color: m.online ? root.nick-color : Theme.text-muted; vertical-alignment: center; overflow: elide; }
                if m.is_bot: BotTag {}
                // Rust fills badge_text with "*bot" for plain bots -- the
                // BotTag above covers that case, so only render chips for
                // real badges (OWNER / staff roles).
                if m.badge_text != "" && m.badge_text != "*bot": Rectangle {
                    background: m.badge_bg;
                    border-width: 1px;
                    border-color: Theme.border-hairline;
                    border-radius: Theme.radius-sm;
                    height: 14px;
                    width: badge-label.preferred-width + 8px;
                    badge-label := Text { text: m.badge_text; font-size: 9px; font-family: Theme.font-medium; color: m.badge_fg; horizontal-alignment: center; vertical-alignment: center; }
                }
                if m.is_plus: Rectangle {
                    background: Theme.plus;
                    border-width: 1px;
                    border-color: Theme.border-hairline;
                    border-radius: Theme.radius-sm;
                    height: 14px;
                    width: plus-m-label.preferred-width + 8px;
                    plus-m-label := Text { text: "PLUS"; font-size: 9px; font-family: Theme.font-medium; color: Theme.plus-foreground; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
            // Role chips: hairline outline, color pip, muted name.
            if m.roles.length > 0: HorizontalLayout {
                spacing: 4px;
                alignment: start;
                for tag in m.roles: Rectangle {
                    height: 16px;
                    width: tag-label.preferred-width + 18px;
                    background: Theme.bg-tertiary;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: Theme.radius-sm;
                    Rectangle { x: 5px; y: 5px; width: 6px; height: 6px; border-radius: 3px; background: tag.color; }
                    tag-label := Text { x: 14px; width: parent.width - 18px; text: tag.name; font-size: 9px; color: Theme.text-muted; vertical-alignment: center; overflow: elide; }
                }
            }
        }
    }
}

export component MembersDrawer inherits HorizontalLayout {
    in property <bool> collapsed: true;
    in property <length> panel_width: 220px;
    in property <int> total_count: 0;
    in property <int> online_count: 0;
    in property <[MemberRow]> online_members: [];
    in property <[MemberRow]> offline_members: [];
    in property <[MemberRow]> bot_members: [];
    // Optional Discord-hoisted role grouping (e.g. "ADMINISTRATOR — 3").
    // When non-empty it replaces the ONLINE / OFFLINE / BOTS split below.
    in property <[MemberGroupRow]> role_groups: [];

    callback toggle;
    callback open_profile(string);
    callback resize_started;
    callback resize_moved(length);
    callback resize_ended;

    ResizeHandle {
        drag-started => { root.resize_started(); }
        drag-moved(x) => { root.resize_moved(x); }
        drag-ended => { root.resize_ended(); }
    }

    if root.collapsed: Rectangle {
        width: 28px;
        background: Theme.bg-secondary;
        border-width: 1px;
        border-color: Theme.border;
        VerticalLayout {
            padding-top: 12px;
            padding-bottom: 12px;
            spacing: 12px;
            // No `alignment: start`: it would disable the stretchy spacer
            // below (pinning the member count right under the button
            // instead of at the bottom) and cap the layout's max height,
            // which clamps the whole window scene (see ResizeHandle).
            collapse-btn := Rectangle {
                height: 24px;
                background: collapse-touch.has-hover ? Theme.bg-hover : transparent;
                animate background { duration: 120ms; }
                Text { text: "›"; font-size: 14px; color: collapse-touch.has-hover ? Theme.accent : Theme.text-muted; horizontal-alignment: center; }
                collapse-touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.toggle(); } }
            }
            Rectangle { vertical-stretch: 1; }
            Text {
                text: root.total_count;
                font-size: Theme.text-xs;
                font-family: Theme.font-medium;
                color: Theme.text-muted;
                horizontal-alignment: center;
            }
        }
    }

    if !root.collapsed: Rectangle {
        width: root.panel_width;
        background: Theme.bg-secondary;
        border-width: 1px;
        border-color: Theme.border;
        VerticalLayout {
            HorizontalLayout {
                padding-left: Theme.space-3;
                padding-right: Theme.space-2;
                padding-top: Theme.space-3;
                padding-bottom: Theme.space-2;
                Text { text: "MEMBERS"; font-size: Theme.text-xs; font-family: Theme.font-medium; letter-spacing: 1px; color: Theme.text-muted; vertical-alignment: center; horizontal-stretch: 1; }
                Rectangle {
                    width: 20px;
                    height: 20px;
                    background: expand-touch.has-hover ? Theme.bg-hover : transparent;
                    animate background { duration: 120ms; }
                    Text { text: "«"; font-size: 14px; color: expand-touch.has-hover ? Theme.accent : Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                    expand-touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.toggle(); } }
                }
            }
            Rectangle { height: 1px; background: Theme.border-hairline; }
            Rectangle { height: 6px; }
            Text {
                x: Theme.space-3;
                text: "\{root.online_count} online · \{root.total_count} total";
                font-size: Theme.text-xs;
                color: Theme.text-muted;
            }
            Rectangle { height: 6px; }
            Flickable {
                vertical-stretch: 1;
                viewport-height: members_col.preferred-height;
                members_col := VerticalLayout {
                    width: parent.width;

                    // Discord-style hoisted role groups -- rendered only
                    // when the integrator feeds them.
                    if root.role_groups.length > 0: VerticalLayout {
                        alignment: start;
                        for group in root.role_groups: VerticalLayout {
                            alignment: start;
                            MemberSectionHeader {
                                text: "\{group.title} — \{group.members.length}";
                                label-color: group.color.alpha > 0 ? group.color : Theme.text-muted;
                            }
                            for m in group.members: MemberEntry {
                                m: m;
                                open_profile(id) => { root.open_profile(id); }
                            }
                        }
                    }

                    // Classic presence split (current Rust data path).
                    if root.role_groups.length == 0: VerticalLayout {
                        alignment: start;
                        if root.online_members.length > 0: MemberSectionHeader { text: "ONLINE — \{root.online_members.length}"; label-color: Theme.online; }
                        for m in root.online_members: MemberEntry { m: m; open_profile(id) => { root.open_profile(id); } }
                        if root.offline_members.length > 0: Rectangle { height: Theme.space-2; }
                        if root.offline_members.length > 0: MemberSectionHeader { text: "OFFLINE — \{root.offline_members.length}"; }
                        for m in root.offline_members: MemberEntry { m: m; open_profile(id) => { root.open_profile(id); } }
                        if root.bot_members.length > 0: Rectangle { height: Theme.space-2; }
                        if root.bot_members.length > 0: MemberSectionHeader { text: "BOTS — \{root.bot_members.length}"; label-color: Theme.accent; }
                        for m in root.bot_members: MemberEntry { m: m; open_profile(id) => { root.open_profile(id); } }
                    }

                    if root.total_count == 0 && root.role_groups.length == 0: Text {
                        x: Theme.space-3;
                        text: "No members yet";
                        font-size: Theme.text-sm;
                        color: Theme.text-muted;
                    }
                }
            }
        }
    }
}
