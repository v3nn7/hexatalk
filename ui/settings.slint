// App-wide Settings screen (Account / Privacy / Bots / Voice / About) --
// port of src/view/settings.rs. Overlay layout: left nav rail with rounded
// category items under small-caps section headers, right content column
// capped at a readable width with rounded section cards and a round ESC
// close button top-right. Colors and corner radii come from Theme
// tokens; pill/circle shapes keep literal half-height radii.
import { Slider } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Avatar, SecondaryButton, PrimaryButton, DangerButton, TextInputField, FieldLabel, SectionTitle, Badge, Divider, BotTag } from "widgets.slint";

export enum SettingsCategory { Account, Privacy, Plus, Bots, Voice, Appearance, About }

export struct BotRow {
    bot_id: string,
    display_name: string,
    username: string,
}

export struct DeviceRow {
    name: string,
    selected: bool,
}

component SectionCard inherits Rectangle {
    background: Theme.bg-secondary;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: Theme.radius-md;
    clip: true;
    VerticalLayout { padding: Theme.space-5; spacing: Theme.space-4; @children }
}

// Discord-style settings row: title + muted description on the left, an
// animated pill switch on the right. Shared by every toggle in the app.
component ToggleRow inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <bool> value;
    callback toggled;
    height: content.preferred-height;
    content := HorizontalLayout {
        spacing: Theme.space-3;
        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;
            Text { text: root.title; font-size: Theme.text-md; color: Theme.text-primary; }
            Text { text: root.description; font-size: Theme.text-sm; color: Theme.text-muted; wrap: word-wrap; }
        }
        // Centered via a stretch VerticalLayout: the row's height is driven
        // by the two-line title/description text, which is taller than the
        // switch, so a bare vertical-stretch:0 child top-aligns instead of
        // centering (same fix as the sidebar unread dot / role swatch).
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 42px;
                height: 24px;
                border-radius: 12px;
                background: root.value ? Theme.accent : Theme.bg-tertiary;
                border-width: 1px;
                border-color: root.value ? Theme.accent : Theme.border-strong;
                animate background { duration: 150ms; }
                animate border-color { duration: 150ms; }
                Rectangle {
                    x: root.value ? parent.width - self.width - 3px : 3px;
                    y: (parent.height - self.height) / 2;
                    width: 18px;
                    height: 18px;
                    border-radius: 9px;
                    background: white;
                    animate x { duration: 150ms; easing: ease-in-out; }
                }
                TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.toggled(); } }
            }
        }
    }
}

// Discord-style nav row: rounded rect, hover wash, solid active fill.
component SidebarItem inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    callback clicked;
    height: 32px;
    border-radius: Theme.radius-sm;
    background: root.active ? Theme.bg-active : (touch.has-hover ? Theme.bg-hover : transparent);
    animate background { duration: 120ms; }
    touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
    Text {
        x: 10px;
        width: parent.width - 20px;
        text: root.text;
        font-size: 13px;
        font-family: root.active ? Theme.font-medium : Theme.font-body;
        color: root.active || touch.has-hover ? Theme.text-primary : Theme.text-muted;
        vertical-alignment: center;
        overflow: elide;
        animate color { duration: 120ms; }
    }
}

component DeviceItem inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    callback clicked;
    height: 34px;
    border-radius: Theme.radius-sm;
    background: root.active ? Theme.accent-soft : (touch.has-hover ? Theme.bg-hover : transparent);
    animate background { duration: 120ms; }
    touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
    Text {
        x: 10px;
        width: parent.width - 20px;
        text: root.text;
        font-size: 13px;
        color: root.active || touch.has-hover ? Theme.text-primary : Theme.text-muted;
        vertical-alignment: center;
        overflow: elide;
        animate color { duration: 120ms; }
    }
}

export component SettingsScreen inherits Rectangle {
    in property <SettingsCategory> category: SettingsCategory.Account;

    // Account
    in property <string> avatar_initial;
    in property <color> avatar_color: Theme.accent;
    in property <image> avatar_photo;
    in property <bool> has_photo: false;
    in property <bool> avatar_upload_busy: false;
    in-out property <string> display_name_input;
    in-out property <string> status_input;
    in-out property <string> bio_input;
    in property <int> selected_avatar_index: -1;
    in property <string> profile_status;
    // Error/success split for the status lines (Rust sets the flag where it
    // sets the text) -- errors render danger, everything else success.
    in property <bool> profile_status_is_error: false;
    in-out property <string> current_password_input;
    in-out property <string> new_password_input;
    in-out property <string> confirm_password_input;
    in property <string> password_status;
    in property <bool> password_status_is_error: false;

    // Privacy
    in property <string> my_badge_text;
    in property <color> my_badge_bg;
    in property <color> my_badge_fg;
    in property <bool> store_chat_history: true;
    in property <bool> hide_online_status: false;
    in property <bool> share_activity: true;
    in property <string> current_activity;
    in property <bool> friends_only_dms: false;
    in property <bool> discoverable: true;
    in property <string> friend_request_privacy_label;
    in property <string> presence_status_label;
    in property <bool> is_staff: false;

    // Bots
    in-out property <string> new_bot_name_input;
    in property <string> bot_token_reveal;
    in property <[BotRow]> my_bots: [];
    in-out property <string> bot_invite_username_input;
    in property <string> bot_status;
    in property <bool> bot_status_is_error: false;

    // Voice
    in property <[DeviceRow]> input_devices: [];
    in property <[DeviceRow]> output_devices: [];
    in property <float> noise_gate: 0;
    in property <string> noise_gate_label;
    // Global UI scale (0.8–1.4), synced from Rust on screen open / after
    // the debounced persist round-trip. The slider edits a local pending
    // copy instead (same anti-jitter pattern as the noise gate).
    in property <float> ui_scale: 1;

    // About
    in property <string> version_line;
    in property <string> vault_hint;
    in property <string> update_check_status;
    in property <bool> update_ready: false;
    in property <string> ping_status;

    // HexaTalk Plus (cosmetic sub)
    in property <bool> plus_active: false;
    in property <string> plus_status_line;
    in property <string> plus_busy_status;
    in property <bool> plus_checkout_busy: false;

    callback close;
    callback category_changed(SettingsCategory);
    callback plus_subscribe;
    callback plus_manage_billing;
    callback plus_refresh;

    callback pick_avatar;
    callback remove_avatar;
    callback display_name_changed(string);
    callback status_changed(string);
    callback bio_changed(string);
    callback avatar_color_selected(string);
    callback save_profile;
    callback current_password_changed(string);
    callback new_password_changed(string);
    callback confirm_password_changed(string);
    callback change_password;
    callback log_out;

    callback toggle_store_history;
    callback toggle_hide_online;
    callback toggle_share_activity;
    callback toggle_friends_only_dms;
    callback toggle_discoverable;
    callback cycle_friend_request_privacy;
    callback cycle_presence;
    callback sign_out_others;

    callback new_bot_name_changed(string);
    callback create_bot;
    callback refresh_bots;
    callback copy_token(string);
    callback dismiss_token;
    callback regenerate_bot_token(string);
    callback delete_bot(string);
    callback bot_invite_username_changed(string);
    callback invite_bot;

    callback input_device_selected(string);
    callback output_device_selected(string);
    callback noise_gate_changed(float);
    callback ui_scale_changed(float);

    callback check_for_update;
    callback restart_update;
    callback measure_ping;

    background: Theme.bg-primary;

    // Debounce for the noise-gate slider: `changed` fires per drag tick and
    // every tick used to persist settings.json to disk
    // (Message::NoiseGateChanged -> persist_settings). The DSP value itself
    // still applies as soon as the debounce fires, 400ms after the drag
    // stops. Nested Slider callbacks cannot call Timer.restart() safely
    // (codegen binds the timer id to the wrong self), so bump this kick
    // counter and re-arm the timer from the component root.
    property <float> pending_noise_gate: root.noise_gate;
    property <int> noise_gate_kick: 0;
    changed noise_gate_kick => {
        noise_gate_timer.running = false;
        noise_gate_timer.running = true;
    }
    noise_gate_timer := Timer {
        interval: 400ms;
        triggered => {
            self.running = false;
            root.noise_gate_changed(root.pending_noise_gate);
        }
    }

    // UI scale: live zoom applied straight to the Theme global while
    // dragging; Rust persists 400ms after the drag stops.
    property <float> pending_ui_scale: root.ui_scale;
    property <int> ui_scale_kick: 0;
    changed ui_scale_kick => {
        ui_scale_timer.running = false;
        ui_scale_timer.running = true;
    }
    ui_scale_timer := Timer {
        interval: 400ms;
        triggered => {
            self.running = false;
            root.ui_scale_changed(root.pending_ui_scale);
        }
    }

    HorizontalLayout {
        // ---------- Left nav rail ----------
        Rectangle {
            width: 232px;
            background: Theme.bg-secondary;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: Theme.space-4;
                spacing: 2px;
                HorizontalLayout {
                    spacing: Theme.space-2;
                    alignment: start;
                    Image {
                        source: @image-url("../assets/textures/hexatalkicon.png");
                        width: 22px;
                        height: 22px;
                        image-fit: ImageFit.contain;
                    }
                    Text {
                        text: "HexaTalk";
                        font-size: Theme.text-md;
                        font-family: Theme.font-medium;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                    }
                }
                Rectangle { height: Theme.space-2; }
                Divider {}
                Rectangle { height: Theme.space-3; }
                // Caps section headers group the nav like Discord's settings.
                Text {
                    text: "USER SETTINGS";
                    font-size: Theme.text-xs;
                    font-family: Theme.font-medium;
                    letter-spacing: 1px;
                    color: Theme.text-muted;
                }
                Rectangle { height: 2px; }
                SidebarItem { text: "My Account"; active: root.category == SettingsCategory.Account; clicked => { root.category_changed(SettingsCategory.Account); } }
                SidebarItem { text: "Privacy"; active: root.category == SettingsCategory.Privacy; clicked => { root.category_changed(SettingsCategory.Privacy); } }
                SidebarItem { text: "HexaTalk Plus"; active: root.category == SettingsCategory.Plus; clicked => { root.category_changed(SettingsCategory.Plus); } }
                SidebarItem { text: "Bots"; active: root.category == SettingsCategory.Bots; clicked => { root.category_changed(SettingsCategory.Bots); } }
                SidebarItem { text: "Voice & Video"; active: root.category == SettingsCategory.Voice; clicked => { root.category_changed(SettingsCategory.Voice); } }
                SidebarItem { text: "Appearance"; active: root.category == SettingsCategory.Appearance; clicked => { root.category_changed(SettingsCategory.Appearance); } }
                Rectangle { height: Theme.space-2; }
                Divider {}
                Rectangle { height: Theme.space-2; }
                Text {
                    text: "APP SETTINGS";
                    font-size: Theme.text-xs;
                    font-family: Theme.font-medium;
                    letter-spacing: 1px;
                    color: Theme.text-muted;
                }
                Rectangle { height: 2px; }
                SidebarItem { text: "About"; active: root.category == SettingsCategory.About; clicked => { root.category_changed(SettingsCategory.About); } }
            }
        }

        // ---------- Right content column ----------
        Flickable {
            horizontal-stretch: 1;
            viewport-height: wrap.preferred-height;
            wrap := VerticalLayout {
                width: parent.width;
                padding: Theme.space-6;
                HorizontalLayout {
                    alignment: start;
                    spacing: Theme.space-5;
                    col := Rectangle {
                        horizontal-stretch: 1;
                        max-width: 760px;
                        pane := VerticalLayout {
                            spacing: Theme.space-5;

                            // Page header mirrors the active nav item.
                            Text {
                                text: root.category == SettingsCategory.Account ? "My Account"
                                    : root.category == SettingsCategory.Privacy ? "Privacy & Security"
                                    : root.category == SettingsCategory.Plus ? "HexaTalk Plus"
                                    : root.category == SettingsCategory.Bots ? "Bots"
                                    : root.category == SettingsCategory.Voice ? "Voice & Video"
                                    : root.category == SettingsCategory.Appearance ? "Appearance"
                                    : "About";
                                font-size: Theme.text-lg;
                                font-family: Theme.font-medium;
                                color: Theme.text-primary;
                            }

                            if root.category == SettingsCategory.Account: SectionCard {
                                SectionTitle { text: "Profile"; }
                                // Brand banner strip above the avatar row,
                                // Discord-profile style.
                                Rectangle {
                                    height: 72px;
                                    clip: true;
                                    border-width: 1px;
                                    border-color: Theme.border-hairline;
                                    border-radius: Theme.radius-md;
                                    Image {
                                        source: @image-url("../assets/textures/hexatalkbaner.png");
                                        width: parent.width;
                                        height: parent.height;
                                        image-fit: ImageFit.cover;
                                    }
                                }
                                HorizontalLayout {
                                    spacing: Theme.space-4;
                                    Avatar { size: 72px; initial: root.avatar_initial; avatar-color: root.avatar_color; photo-source: root.avatar_photo; }
                                    VerticalLayout {
                                        spacing: 6px;
                                        alignment: start;
                                        SecondaryButton { text: root.avatar_upload_busy ? "Uploading..." : "Upload photo"; enabled: !root.avatar_upload_busy; clicked => { root.pick_avatar(); } }
                                        if root.has_photo: Text { text: "Remove photo"; font-size: 12px; color: rm_photo_touch.has-hover ? Theme.accent-hover : Theme.text-link; rm_photo_touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.remove_avatar(); } } }
                                        Text { text: "PNG or JPG, under 2MB."; font-size: 11px; color: Theme.text-muted; }
                                    }
                                }
                                FieldLabel { text: "Display name"; }
                                TextInputField { placeholder: "Display name"; value <=> root.display_name_input; edited(t) => { root.display_name_changed(t); } }
                                FieldLabel { text: "Status message"; }
                                TextInputField { placeholder: "What's on your mind?"; value <=> root.status_input; edited(t) => { root.status_changed(t); } }
                                FieldLabel { text: "Bio"; }
                                TextInputField { placeholder: "Tell people a bit about yourself"; value <=> root.bio_input; edited(t) => { root.bio_changed(t); } }
                                FieldLabel { text: "Avatar color"; }
                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    for c[i] in [
                                        { hex: "#3FB36B", col: #3FB36B },
                                        { hex: "#2E9E6B", col: #2E9E6B },
                                        { hex: "#7FCBA0", col: #7FCBA0 },
                                        { hex: "#2F8F57", col: #2F8F57 },
                                        { hex: "#A9B85E", col: #A9B85E },
                                        { hex: "#5FB98C", col: #5FB98C },
                                        { hex: "#27814F", col: #27814F },
                                        { hex: "#9FD3B5", col: #9FD3B5 },
                                    ]: Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        border-radius: 14px;
                                        background: c.col;
                                        border-width: root.selected_avatar_index == i ? 2px : 1px;
                                        border-color: root.selected_avatar_index == i ? Theme.accent : Theme.border;
                                        TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.avatar_color_selected(c.hex); } }
                                    }
                                }
                                PrimaryButton { text: "Save profile"; width: 200px; clicked => { root.save_profile(); } }
                                if root.profile_status != "": Text { text: root.profile_status; font-size: 12px; color: root.profile_status_is_error ? Theme.danger : Theme.success; }
                            }
                            if root.category == SettingsCategory.Account: SectionCard {
                                SectionTitle { text: "Change password"; }
                                TextInputField { placeholder: "Current password"; is-password: true; value <=> root.current_password_input; edited(t) => { root.current_password_changed(t); } }
                                TextInputField { placeholder: "New password"; is-password: true; value <=> root.new_password_input; edited(t) => { root.new_password_changed(t); } }
                                TextInputField { placeholder: "Confirm new password"; is-password: true; value <=> root.confirm_password_input; edited(t) => { root.confirm_password_changed(t); } }
                                PrimaryButton { text: "Change password"; width: 200px; clicked => { root.change_password(); } }
                                if root.password_status != "": Text { text: root.password_status; font-size: 12px; color: root.password_status_is_error ? Theme.danger : Theme.success; }
                            }
                            if root.category == SettingsCategory.Account: Rectangle {
                                background: Theme.danger-soft;
                                border-width: 1px;
                                border-color: Theme.danger-dim;
                                border-radius: Theme.radius-md;
                                VerticalLayout {
                                    padding: Theme.space-5;
                                    spacing: Theme.space-4;
                                    SectionTitle { text: "Session"; }
                                    Text { text: "Sign out of this device. You can sign back in anytime."; font-size: 12px; color: Theme.text-muted; wrap: word-wrap; }
                                    DangerButton { text: "Log out"; width: 200px; clicked => { root.log_out(); } }
                                }
                            }

                            if root.category == SettingsCategory.Privacy: SectionCard {
                                SectionTitle { text: "Privacy & Security"; }
                                Text { text: "Control how others see you, what is stored, and who can reach you."; font-size: 12px; color: Theme.text-muted; wrap: word-wrap; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: "Your badges:"; font-size: 12px; color: Theme.text-muted; vertical-alignment: center; }
                                    if root.my_badge_text != "": Badge { text: root.my_badge_text; bg: root.my_badge_bg; fg: root.my_badge_fg; }
                                    if root.my_badge_text == "": Text { text: "none"; font-size: 11px; color: Theme.text-muted; vertical-alignment: center; }
                                }
                                Divider {}
                                ToggleRow { title: "Chat history storage"; description: "Off = live-only (peerseal); nothing saved on Convex for chats you're in."; value: root.store_chat_history; toggled => { root.toggle_store_history(); } }
                                ToggleRow { title: "Hide online status"; description: "Others see you as offline (you still receive messages)."; value: root.hide_online_status; toggled => { root.toggle_hide_online(); } }
                                ToggleRow {
                                    title: "Share detected app activity";
                                    description: "Show what you're playing or working in (Minecraft, RustRover, VS Code, …) on your profile. Turn off to stop scanning apps.";
                                    value: root.share_activity;
                                    toggled => { root.toggle_share_activity(); }
                                }
                                if root.share_activity && root.current_activity != "": Text {
                                    text: "Detected now: " + root.current_activity + "  (foreground app + running processes)";
                                    font-size: 11px;
                                    color: Theme.accent;
                                    wrap: word-wrap;
                                }
                                if root.share_activity && root.current_activity == "": Text {
                                    text: "No known app detected right now.";
                                    font-size: 11px;
                                    color: Theme.text-muted;
                                    wrap: word-wrap;
                                }
                                ToggleRow { title: "Friends-only DMs"; description: "Only people on your friends list can start a direct chat."; value: root.friends_only_dms; toggled => { root.toggle_friends_only_dms(); } }
                                ToggleRow { title: "Discoverable profile"; description: "When off, you are harder to find (exact username still works)."; value: root.discoverable; toggled => { root.toggle_discoverable(); } }
                                Divider {}
                                FieldLabel { text: "Friend requests"; }
                                SecondaryButton { text: "Who can request: " + root.friend_request_privacy_label; clicked => { root.cycle_friend_request_privacy(); } }
                                Text { text: "Everyone · Shared servers only · Nobody. Click to cycle. Decline has a 24h re-request cooldown."; font-size: 11px; color: Theme.text-muted; wrap: word-wrap; }
                                FieldLabel { text: "My presence"; }
                                SecondaryButton { text: "Status: " + root.presence_status_label; clicked => { root.cycle_presence(); } }
                                Text { text: "Online · Idle · Do not disturb · Invisible. Invisible hides you like offline."; font-size: 11px; color: Theme.text-muted; wrap: word-wrap; }
                                FieldLabel { text: "Sessions"; }
                                SecondaryButton { text: "Sign out other devices"; clicked => { root.sign_out_others(); } }
                                Text { text: "Keeps this session; revokes every other login token on this account. Device list: prefs:listSessions / prefs:revokeSession (backend ready)."; font-size: 11px; color: Theme.text-muted; wrap: word-wrap; }
                                Text { text: "Per-chat Store ON/OFF is in the DM header (not on server channels)."; font-size: 11px; color: Theme.text-muted; wrap: word-wrap; }
                                if root.is_staff: Rectangle {
                                    background: Theme.bg-tertiary;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    border-radius: Theme.radius-md;
                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 4px;
                                        Text { text: "STAFF PRIVILEGES"; font-size: 11px; color: Theme.warning; }
                                        Text {
                                            text: "Admins cannot be blocked or kicked from servers. Friend requests still require acceptance. Support DMs work without friendship. Moderators can ban users but not staff.";
                                            font-size: 11px;
                                            color: Theme.text-muted;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }

                            if root.category == SettingsCategory.Plus: SectionCard {
                                SectionTitle { text: "HexaTalk Plus"; }
                                Text {
                                    text: "Cosmetic perks only — never pay-to-win. No better voice, no extra power on servers, no competitive advantages.";
                                    font-size: 12px;
                                    color: Theme.text-muted;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    if root.plus_active: Badge {
                                        text: "PLUS";
                                        bg: Theme.plus;
                                        fg: Theme.plus-foreground;
                                    }
                                    Text {
                                        text: root.plus_status_line;
                                        font-size: 13px;
                                        color: root.plus_active ? Theme.text-primary : Theme.text-muted;
                                        vertical-alignment: center;
                                        wrap: word-wrap;
                                        horizontal-stretch: 1;
                                    }
                                }
                                Divider {}
                                Text { text: "What you get"; font-size: Theme.text-sm; font-family: Theme.font-medium; color: Theme.text-primary; }
                                Text { text: "• PLUS badge next to your name in chat, members & profile"; font-size: 12px; color: Theme.text-muted; wrap: word-wrap; }
                                Text { text: "• Gold name highlight on your profile"; font-size: 12px; color: Theme.text-muted; wrap: word-wrap; }
                                Text { text: "• Gold avatar ring + banner strip (or custom banner)"; font-size: 12px; color: Theme.text-muted; wrap: word-wrap; }
                                Text { text: "• Custom profile banner image"; font-size: 12px; color: Theme.text-muted; wrap: word-wrap; }
                                Text { text: "• Any avatar color (#RRGGBB)"; font-size: 12px; color: Theme.text-muted; wrap: word-wrap; }
                                Text { text: "• Longer status message & bio"; font-size: 12px; color: Theme.text-muted; wrap: word-wrap; }
                                Text { text: "• Subtle gold border on the profile info card"; font-size: 12px; color: Theme.text-muted; wrap: word-wrap; }
                                Divider {}
                                HorizontalLayout {
                                    spacing: 8px;
                                    if !root.plus_active: PrimaryButton {
                                        text: root.plus_checkout_busy ? "Opening…" : "Buy Plus — buy.vyrapp.pro";
                                        width: 240px;
                                        enabled: !root.plus_checkout_busy;
                                        clicked => { root.plus_subscribe(); }
                                    }
                                    if root.plus_active: PrimaryButton {
                                        text: root.plus_checkout_busy ? "Opening…" : "Manage billing";
                                        width: 180px;
                                        enabled: !root.plus_checkout_busy;
                                        clicked => { root.plus_manage_billing(); }
                                    }
                                    SecondaryButton {
                                        text: "Refresh status";
                                        width: 130px;
                                        enabled: !root.plus_checkout_busy;
                                        clicked => { root.plus_refresh(); }
                                    }
                                }
                                if root.plus_busy_status != "": Text {
                                    text: root.plus_busy_status;
                                    font-size: 12px;
                                    color: Theme.text-muted;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: "Purchase page: https://buy.vyrapp.pro  ·  Stripe handles the card. After paying, click Refresh status (or reopen settings).";
                                    font-size: 11px;
                                    color: Theme.text-muted;
                                    wrap: word-wrap;
                                }
                            }

                            if root.category == SettingsCategory.Bots: SectionCard {
                                SectionTitle { text: "HexaTalk bots"; }
                                Text { text: "Headless bots: create here, invite to a server, run with crates/hexatalk-bot."; font-size: 12px; color: Theme.text-muted; wrap: word-wrap; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    TextInputField { placeholder: "Bot display name"; value <=> root.new_bot_name_input; edited(t) => { root.new_bot_name_changed(t); } submitted => { root.create_bot(); } }
                                    PrimaryButton { text: "Create"; width: 90px; clicked => { root.create_bot(); } }
                                }
                                Text { text: "Refresh list"; font-size: 11px; color: Theme.text-link; TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.refresh_bots(); } } }
                                if root.bot_token_reveal != "": Rectangle {
                                    background: Theme.bg-tertiary;
                                    border-width: 1px;
                                    border-color: Theme.warning;
                                    border-radius: Theme.radius-md;
                                    VerticalLayout {
                                        padding: 12px;
                                        spacing: 8px;
                                        Text { text: "COPY TOKEN NOW (shown once)"; font-size: 11px; color: Theme.warning; }
                                        Text { text: root.bot_token_reveal; font-size: 12px; color: Theme.accent; wrap: word-wrap; }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            PrimaryButton { text: "Copy"; width: 80px; clicked => { root.copy_token(root.bot_token_reveal); } }
                                            SecondaryButton { text: "Dismiss"; width: 80px; clicked => { root.dismiss_token(); } }
                                        }
                                    }
                                }
                                if root.my_bots.length == 0: Text {
                                    text: "No bots yet -- create one above to get started.";
                                    font-size: 12px;
                                    color: Theme.text-muted;
                                    wrap: word-wrap;
                                }
                                for bot in root.my_bots: Rectangle {
                                    background: Theme.bg-tertiary;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    border-radius: Theme.radius-md;
                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 6px;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Text { text: bot.display_name; font-size: 13px; color: Theme.text-primary; horizontal-stretch: 1; vertical-alignment: center; }
                                            BotTag { vertical-stretch: 0; }
                                            Text { text: "@" + bot.username; font-size: 11px; color: Theme.text-muted; vertical-alignment: center; }
                                        }
                                        HorizontalLayout {
                                            spacing: 6px;
                                            SecondaryButton { text: "New token"; clicked => { root.regenerate_bot_token(bot.bot_id); } }
                                            DangerButton { text: "Delete"; clicked => { root.delete_bot(bot.bot_id); } }
                                        }
                                    }
                                }
                                FieldLabel { text: "Invite bot to current server"; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    TextInputField { placeholder: "bot_username"; value <=> root.bot_invite_username_input; edited(t) => { root.bot_invite_username_changed(t); } submitted => { root.invite_bot(); } }
                                    PrimaryButton { text: "Invite"; width: 90px; clicked => { root.invite_bot(); } }
                                }
                                Text { text: "Select a server on the rail first. Owner only."; font-size: 10px; color: Theme.text-muted; }
                                if root.bot_status != "": Text { text: root.bot_status; font-size: 12px; color: root.bot_status_is_error ? Theme.danger : Theme.success; }
                            }

                            if root.category == SettingsCategory.Voice: SectionCard {
                                SectionTitle { text: "Voice & audio"; }
                                FieldLabel { text: "Microphone"; }
                                if root.input_devices.length == 0: Text {
                                    text: "No input devices found.";
                                    font-size: 12px;
                                    color: Theme.text-muted;
                                }
                                VerticalLayout {
                                    spacing: 2px;
                                    for d in root.input_devices: DeviceItem { text: d.name; active: d.selected; clicked => { root.input_device_selected(d.name); } }
                                }
                                FieldLabel { text: "Speaker"; }
                                if root.output_devices.length == 0: Text {
                                    text: "No output devices found.";
                                    font-size: 12px;
                                    color: Theme.text-muted;
                                }
                                VerticalLayout {
                                    spacing: 2px;
                                    for d in root.output_devices: DeviceItem { text: d.name; active: d.selected; clicked => { root.output_device_selected(d.name); } }
                                }
                                Text { text: "Device choice applies the next time you start or accept a call."; font-size: 11px; color: Theme.text-muted; wrap: word-wrap; }
                                Divider {}
                                FieldLabel { text: "Noise gate sensitivity"; }
                                Slider {
                                    minimum: 0;
                                    maximum: 0.03;
                                    value: root.noise_gate;
                                    changed(v) => {
                                        root.pending_noise_gate = v;
                                        root.noise_gate_kick += 1;
                                    }
                                }
                                HorizontalLayout {
                                    Text { text: "Off"; font-size: 10px; color: Theme.text-muted; }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text { text: root.noise_gate_label; font-size: 11px; color: Theme.text-primary; }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text { text: "Aggressive"; font-size: 10px; color: Theme.text-muted; }
                                }
                                Text { text: "Cuts background hiss between words. Applies live, even mid-call."; font-size: 11px; color: Theme.text-muted; wrap: word-wrap; }
                                Text {
                                    text: "Local DSP (on-device, free): soft noise gate + high-pass rumble cut + AGC (auto gain) + deharsh LPF. No cloud processing, low CPU.";
                                    font-size: 11px;
                                    color: Theme.text-muted;
                                    wrap: word-wrap;
                                }
                            }

                            if root.category == SettingsCategory.Appearance: SectionCard {
                                SectionTitle { text: "Appearance"; }
                                FieldLabel { text: "UI scale"; }
                                HorizontalLayout {
                                    spacing: Theme.space-3;
                                    Slider {
                                        horizontal-stretch: 1;
                                        minimum: 0.8;
                                        maximum: 1.4;
                                        value <=> root.pending_ui_scale;
                                        changed(v) => {
                                            Theme.ui-scale = v;
                                            root.ui_scale_kick += 1;
                                        }
                                    }
                                    Text {
                                        text: Math.round(root.pending_ui_scale * 100) + "%";
                                        font-size: Theme.text-sm;
                                        color: Theme.text-muted;
                                        width: 44px;
                                        vertical-alignment: center;
                                    }
                                }
                                Text {
                                    text: "Zoom the whole interface — text, spacing and corners scale together. Applies instantly, saved automatically.";
                                    font-size: Theme.text-sm;
                                    color: Theme.text-muted;
                                    wrap: word-wrap;
                                }
                            }

                            if root.category == SettingsCategory.About: SectionCard {
                                SectionTitle { text: "About"; }
                                Text { text: root.version_line; font-size: 14px; font-family: Theme.font-medium; color: Theme.text-link; }
                                Text { text: "DM history lives on Convex (shared). Live transport is peerseal."; font-size: 12px; color: Theme.text-muted; wrap: word-wrap; }
                                Text { text: "Local data dir: " + root.vault_hint; font-size: 10px; color: Theme.text-muted; wrap: word-wrap; }
                                SecondaryButton { text: "Check for updates"; width: 180px; clicked => { root.check_for_update(); } }
                                if root.update_ready: PrimaryButton { text: "Restart & install update"; width: 180px; clicked => { root.restart_update(); } }
                                if root.update_check_status != "": Text { text: root.update_check_status; font-size: 12px; color: Theme.text-muted; }
                                SecondaryButton { text: "Ping server"; width: 180px; clicked => { root.measure_ping(); } }
                                if root.ping_status != "": Text { text: "ping: " + root.ping_status; font-size: 12px; color: Theme.text-link; }
                            }

                            // Version footer, visible from every category.
                            Divider {}
                            Text {
                                text: root.version_line;
                                font-size: Theme.text-xs;
                                color: Theme.text-muted;
                            }
                        }
                    }

                    // ESC close box pinned to the top-right of the content,
                    // like Discord's settings overlay affordance.
                    VerticalLayout {
                        width: 52px;
                        alignment: start;
                        spacing: Theme.space-1;
                        Rectangle {
                            width: 40px;
                            height: 40px;
                            border-radius: 20px;
                            background: esc-touch.has-hover ? Theme.bg-hover : transparent;
                            border-width: 2px;
                            border-color: esc-touch.has-hover ? Theme.border-strong : Theme.border;
                            animate background { duration: 120ms; }
                            animate border-color { duration: 120ms; }
                            esc-touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.close(); } }
                            Text {
                                text: "✕";
                                font-size: Theme.text-md;
                                color: esc-touch.has-hover ? Theme.text-primary : Theme.text-muted;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                animate color { duration: 120ms; }
                            }
                        }
                        Text {
                            text: "ESC";
                            width: 40px;
                            font-size: Theme.text-xs;
                            font-family: Theme.font-medium;
                            letter-spacing: 1px;
                            color: Theme.text-muted;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
